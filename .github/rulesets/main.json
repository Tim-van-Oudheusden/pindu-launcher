{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Rust and Meson checks", "integration_id": 15368 },
          { "context": "Source tarball with vendored crates", "integration_id": 15368 },
          { "context": "Flatpak build, UI smoke test and lint (development)", "integration_id": 15368 },
          { "context": "Flatpak build, UI smoke test and lint (release)", "integration_id": 15368 },
          { "context": "Native package install and UI smoke test (fedora-45)", "integration_id": 15368 },
          { "context": "Native package install and UI smoke test (debian-testing)", "integration_id": 15368 },
          { "context": "Native package install and UI smoke test (ubuntu-26.10)", "integration_id": 15368 },
          { "context": "Merge queue script tests", "integration_id": 15368 }
        ]
      }
    }
  ]
}
