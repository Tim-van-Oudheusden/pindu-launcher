#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:153
msgid ""
"Play a soft sound in fullscreen mode when the controller moves focus, "
"selects or goes back."
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:158
msgid "Navigation sound volume"
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:159
msgid "How loud the navigation sounds play, from 0 (silent) to 100 (full)."
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:163
msgid "Reduce motion in fullscreen mode"
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:164
msgid ""
"Hold Home's animated background on its first frame and change art without a "
"crossfade in fullscreen mode. Turning off animations in the system settings "
"does the same."
msgstr ""

