msgid ""
"Open the window in fullscreen mode, the controller-driven presentation of "
"the library."
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:103
msgid "Navigation sounds"
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:104
msgid ""
"Play a soft sound in fullscreen mode when the controller moves focus, "
"selects or goes back."
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:109
msgid "Navigation sound volume"
msgstr ""

#: data/io.github.tim_van_oudheusden.pindu-launcher.gschema.xml.in:110
