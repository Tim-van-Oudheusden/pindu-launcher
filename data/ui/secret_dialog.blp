using Gtk 4.0;
using Adw 1;

// The passphrase and PIN dialog: the caller's title and message, an entry that hides its
// text, and the on-screen keyboard, whose keys secret_dialog.rs lays out from
// pindu_core::osk. The entry takes the focus, so a keyboard types into it too.
template $PinduSecretDialog: Adw.Dialog {
  content-width: 720;
  focus-widget: entry;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "window.close";
      }

      [end]
      Button {
        label: _("_Done");
        use-underline: true;
        clicked => $confirm() swapped;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 18;
      margin-top: 12;
      margin-bottom: 24;
      margin-start: 24;
      margin-end: 24;

      Label message {
        wrap: true;
        xalign: 0;
      }

      Entry entry {
        visibility: false;
        input-purpose: password;
        activate => $confirm() swapped;
      }

      // Styled as the search keyboard.
      Grid keyboard_grid {
        halign: center;
        row-spacing: 8;
        column-spacing: 8;
        column-homogeneous: true;
        row-homogeneous: true;

        styles [
          "search-keyboard",
        ]
      }
    };
  };
}
