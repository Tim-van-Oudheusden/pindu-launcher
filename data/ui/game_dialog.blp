using Gtk 4.0;
using Adw 1;

template $PinduGameDialog: Adw.Dialog {
  content-width: 560;
  content-height: 680;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "window.close";
      }

      [end]
      Button save_button {
        use-underline: true;
        sensitive: false;
        clicked => $save() swapped;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Adw.PreferencesPage {
        Adw.PreferencesGroup game_group {
          title: _("Game");
          description: _("Choose the game's folder; its program, title and options come next.");

          Adw.ComboRow kind_row {
            title: _("Type");

            model: StringList {
              strings [
                _("Native"),
                _("Windows"),
              ]
            };
          }

          Adw.SwitchRow host_row {
            title: _("Run on the Host");
            subtitle: _("Start the game outside the Steam Linux Runtime. This needs permission to run programs on this computer.");
            notify::active => $form_changed() swapped;
          }

          Adw.ActionRow folder_row {
            title: _("Game Folder");
            subtitle: _("None chosen");

            [suffix]
            Button {
              label: _("_Choose…");
              use-underline: true;
              valign: center;
              clicked => $choose_folder() swapped;
            }
          }

          Adw.ComboRow executable_row {
            title: _("Program");
            sensitive: false;

            model: StringList executables {};
          }

          Adw.EntryRow title_row {
            title: _("Title");
            changed => $form_changed() swapped;
          }

          Adw.EntryRow arguments_row {
            title: _("Arguments");
            changed => $form_changed() swapped;
          }

          Adw.EntryRow working_dir_row {
            title: _("Working Folder (empty for the program's folder)");
            changed => $form_changed() swapped;
          }
        }

        Adw.PreferencesGroup windows_group {
          title: _("Windows");
          description: _("Windows games run through Proton, each in a prefix: a folder that holds its Windows files and saves.");
          visible: false;

          // Shown when umu-run is missing: a native install without umu-launcher.
          Adw.ActionRow umu_row {
            title: _("umu-launcher Is Not Installed");
            subtitle: _("Windows games and their installers run through it");
            visible: false;

            [prefix]
            Image {
              icon-name: "dialog-warning-symbolic";
            }

            [suffix]
            LinkButton umu_link {
              label: _("How to Install");
              valign: center;
            }
          }

          Adw.ComboRow proton_row {
            title: _("Proton");

            model: StringList {};
          }

          Adw.ActionRow prefix_row {
            title: _("Prefix");

            [suffix]
            Button reset_prefix_button {
              icon-name: "edit-undo-symbolic";
              tooltip-text: _("Use a New Prefix");
              valign: center;
              visible: false;
              clicked => $reset_prefix() swapped;

              styles [
                "flat",
              ]
            }

            [suffix]
            Button {
              label: _("C_hoose…");
              use-underline: true;
              valign: center;
              clicked => $choose_prefix() swapped;
            }
          }

          Adw.ActionRow installer_row {
            title: _("Installer");
            subtitle: _("Run the game's installer in its prefix, then pick the program it installed");

            [suffix]
            Adw.Spinner installer_spinner {
              visible: false;
            }

            [suffix]
            Button installer_button {
              label: _("_Run Installer…");
              use-underline: true;
              valign: center;
              clicked => $run_installer() swapped;
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Artwork");
          description: _("Pick an image file or paste a web address. Art you pick is used instead of the launcher's.");

          Adw.ActionRow cover_row {
            title: _("Cover");
          }

          Adw.ActionRow hero_row {
            title: _("Banner");
          }

          Adw.ActionRow logo_row {
            title: _("Logo");
          }
        }
      };
    };
  };
}
