using Gtk 4.0;
using Adw 1;

// Quick Access's Bluetooth level, the "bluetooth" page of the window's quick_access_stack.
// Its entry row stays in the window's shared Quick Access list.
template $PinduBluetoothLevel: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Box {
      orientation: vertical;
      spacing: 12;

      Label {
        label: _("Bluetooth");
        xalign: 0;

        styles [
          "title-3",
        ]
      }

      // The radio's switch, or what blocks it.
      ListBox quick_access_bluetooth_adapter {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.SwitchRow quick_access_bluetooth_switch {
          title: _("Bluetooth");
        }

        Adw.ActionRow quick_access_bluetooth_blocked {
          title: _("Bluetooth");
          subtitle: _("Turned off by airplane mode or a hardware switch");
          visible: false;
        }
      }

      Label quick_access_bluetooth_paired_title {
        label: _("Paired Devices");
        xalign: 0;
        margin-top: 6;

        styles [
          "heading",
        ]
      }

      // Each paired device, which opens to Connect or Disconnect and
      // Forget; filled in code, and again as BlueZ reports changes.
      ListBox quick_access_bluetooth_paired {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }

      Label quick_access_bluetooth_found_title {
        label: _("Found Devices");
        xalign: 0;
        margin-top: 6;

        styles [
          "heading",
        ]
      }

      // The devices found nearby while the level is open; selecting one
      // pairs and connects it. Filled in code.
      ListBox quick_access_bluetooth_found {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    };
  };
}
