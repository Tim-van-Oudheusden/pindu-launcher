using Gtk 4.0;
using Adw 1;

template $PinduHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";

  child: Overlay home {
    styles [
      "home",
    ]

    // The chosen animation behind the first screen, under the heroes on the second.
    child: Picture background {
      content-fit: cover;
      can-shrink: true;
      accessible-role: presentation;

      styles [
        "home-background",
      ]
    };

    // A backdrop: the logo or title over it says what it shows. Two pictures, so the
    // incoming art (`.shown`) can fade in over the outgoing one in a design.
    [overlay]
    Picture hero_a {
      content-fit: cover;
      can-shrink: true;
      can-target: false;
      accessible-role: presentation;

      styles [
        "home-hero",
      ]
    }

    [overlay]
    Picture hero_b {
      content-fit: cover;
      can-shrink: true;
      can-target: false;
      accessible-role: presentation;

      styles [
        "home-hero",
      ]
    }

    // Darkens the background and the art under the text while Dim is on (`dim-*`).
    [overlay]
    Box {
      can-target: false;

      styles [
        "home-dim",
      ]
    }

    [overlay]
    Box {
      can-target: false;

      styles [
        "hero-gradient",
      ]
    }

    // The layout of the design in force reorders these (`home-layout-*`).
    [overlay]
    Box content {
      orientation: vertical;
      valign: end;
      spacing: 24;
      margin-bottom: 24;

      Box info {
        orientation: vertical;
        spacing: 12;

        // Over the title while a Jump Back In card has focus on a first screen that
        // starts with them (`home-start`).
        Label eyebrow {
          visible: false;
          label: _("Jump Back In");
          xalign: 0;
          ellipsize: end;
          margin-start: 48;
          margin-end: 48;

          styles [
            "home-eyebrow",
            "heading",
          ]
        }

        Box {
          margin-start: 48;
          margin-end: 48;

          styles [
            "home-title",
          ]

          // The logo stays within its 480×160 box (360×96 in the Shelves layout)
          // whatever the image's size: the clamps cap its natural size, and a design's
          // `min-width`/`min-height` enlarge it.
          Adw.Clamp logo_width {
            maximum-size: 480;
            tightening-threshold: 480;

            child: Adw.Clamp logo_height {
              orientation: vertical;
              maximum-size: 160;
              tightening-threshold: 160;

              child: Picture logo {
                visible: false;
                content-fit: contain;
                width-request: 480;
                height-request: 160;
                can-shrink: true;
                halign: start;

                styles [
                  "home-logo",
                ]
              };
            };
          }

          // In the Shelves layout the box is as tall as the logo's, with the title at
          // its foot, so the rows under it stay in place. The height sits on the box:
          // on the label it would wrap the title to fill it. The box itself does not
          // expand, so the room over the title is not the page's to grow.
          Box title_box {
            orientation: vertical;
            vexpand: false;

            Box {
              vexpand: true;
            }

            Label title {
              wrap: true;
              xalign: 0;

              styles [
                "title-1",
              ]
            }
          }
        }

        // The focused game's details, shown when the design asks for them.
        Box details {
          visible: false;
          spacing: 12;
          margin-start: 48;
          margin-end: 48;
          halign: start;

          styles [
            "home-details",
          ]
        }

        // The focused section's first covers, on the first screen when the design asks
        // for them (`home-section-preview`); filled in code.
        Box preview {
          visible: false;
          spacing: 12;
          margin-start: 48;
          margin-end: 48;
          halign: start;
          can-focus: false;
          can-target: false;
          accessible-role: presentation;

          styles [
            "home-preview",
          ]
        }
      }

      ScrolledWindow carousel_row {
        hscrollbar-policy: external;
        vscrollbar-policy: never;
        propagate-natural-height: true;

        child: Box carousel {
          spacing: 24;
          margin-start: 48;
          margin-end: 48;
          margin-top: 12;
          margin-bottom: 12;

          styles [
            "home-carousel",
          ]

          // The size sits on the tile's frame (`TileFrame`), as on the other tiles, so
          // the margin a design gives the focused tile adds to it rather than squeezing
          // it; the frame is taller only when its text needs it, at a larger Text Size.
          Button library_tile {
            action-name: "win.show-library";

            styles [
              "card",
              "library-tile",
            ]

            child: $PinduTileFrame library_tile_frame {
              // With labelled tiles (`home-section-tile`) the icon moves to the top left
              // and the name to the bottom left, over the number of games.
              Box library_tile_content {
                orientation: vertical;
                spacing: 12;
                valign: center;

                Image library_tile_icon {
                  icon-name: "view-grid-symbolic";
                  pixel-size: 48;
                  accessible-role: presentation;
                }

                Label library_tile_label {
                  label: _("Library");
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                }
              }
            };
          }

          // Where Steam is present: opens Steam Big Picture (`win.steam-big-picture`), and
          // shows that it is opening while the launcher waits for its window.
          Button big_picture_tile {
            visible: false;
            action-name: "win.steam-big-picture";

            styles [
              "card",
              "library-tile",
              "big-picture-tile",
            ]

            child: $PinduTileFrame big_picture_tile_frame {
              Box big_picture_tile_content {
                orientation: vertical;
                spacing: 12;
                valign: center;

                Image big_picture_icon {
                  icon-name: "input-gaming-symbolic";
                  pixel-size: 48;
                  accessible-role: presentation;
                }

                Adw.Spinner big_picture_spinner {
                  visible: false;
                  width-request: 48;
                  height-request: 48;
                  halign: center;
                }

                // Steam's own name for it; the full "Steam Big Picture" shows as the
                // focused tile's title.
                Label big_picture_label {
                  label: _("Big Picture");
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                }

                Label big_picture_status {
                  visible: false;
                  label: _("Opening…");
                  ellipsize: end;

                  styles [
                    "dimmed",
                  ]
                }
              }
            };
          }
        };
      }

      // The Shelves layout (`"home": "shelves"`): every section as a row of its games,
      // then the Library row; the rows are built in code. The page scrolls it itself,
      // to the row that has focus.
      ScrolledWindow shelves_scroller {
        visible: false;
        hscrollbar-policy: never;
        vscrollbar-policy: external;
        vexpand: true;

        styles [
          "home-shelves",
        ]

        child: Box shelves {
          orientation: vertical;
        };
      }
    }
  };
}
