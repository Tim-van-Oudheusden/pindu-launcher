using Gtk 4.0;
using Adw 1;

template $PinduHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";

  child: Overlay home {
    styles [
      "home",
    ]

    // The animated background behind the first screen (`data/home/background-*.webm`, in
    // the size that suits the screen), under the heroes, which only the second screen shows.
    child: Picture background {
      content-fit: cover;
      can-shrink: true;
      accessible-role: presentation;

      styles [
        "home-background",
      ]
    };

    // A backdrop: the logo or title over it says what it shows. Two pictures, so the
    // incoming art (`.shown`) can fade in over the outgoing one in a design.
    [overlay]
    Picture hero_a {
      content-fit: cover;
      can-shrink: true;
      can-target: false;
      accessible-role: presentation;

      styles [
        "home-hero",
      ]
    }

    [overlay]
    Picture hero_b {
      content-fit: cover;
      can-shrink: true;
      can-target: false;
      accessible-role: presentation;

      styles [
        "home-hero",
      ]
    }

    // Darkens the background and the art under the text while Dim is on (`dim-*`).
    [overlay]
    Box {
      can-target: false;

      styles [
        "home-dim",
      ]
    }

    [overlay]
    Box {
      can-target: false;

      styles [
        "hero-gradient",
      ]
    }

    // The layout of the design in force reorders these (`home-layout-*`).
    [overlay]
    Box content {
      orientation: vertical;
      valign: end;
      spacing: 24;
      margin-bottom: 24;

      Box info {
        orientation: vertical;
        spacing: 12;

        Box {
          margin-start: 48;
          margin-end: 48;

          styles [
            "home-title",
          ]

          // The logo stays within its 480×160 box whatever the image's size: the clamps
          // cap its natural size, and a design's `min-width`/`min-height` enlarge it.
          Adw.Clamp {
            maximum-size: 480;
            tightening-threshold: 480;

            child: Adw.Clamp {
              orientation: vertical;
              maximum-size: 160;
              tightening-threshold: 160;

              child: Picture logo {
                visible: false;
                content-fit: contain;
                width-request: 480;
                height-request: 160;
                can-shrink: true;
                halign: start;

                styles [
                  "home-logo",
                ]
              };
            };
          }

          Label title {
            wrap: true;
            xalign: 0;

            styles [
              "title-1",
            ]
          }
        }

        // The focused game's details, shown when the design asks for them.
        Box details {
          visible: false;
          spacing: 12;
          margin-start: 48;
          margin-end: 48;
          halign: start;

          styles [
            "home-details",
          ]
        }
      }

      ScrolledWindow carousel_row {
        hscrollbar-policy: external;
        vscrollbar-policy: never;
        propagate-natural-height: true;

        child: Box carousel {
          spacing: 24;
          margin-start: 48;
          margin-end: 48;
          margin-top: 12;
          margin-bottom: 12;

          styles [
            "home-carousel",
          ]

          // The size sits on the tile's child, as on the other tiles, so the margin a
          // design gives the focused tile adds to it rather than squeezing it.
          Button library_tile {
            action-name: "win.show-library";

            styles [
              "card",
              "library-tile",
            ]

            child: Overlay {
              child: Box library_tile_frame {
                width-request: 320;
                height-request: 150;
              };

              [overlay]
              Box {
                orientation: vertical;
                spacing: 12;
                valign: center;

                Image {
                  icon-name: "view-grid-symbolic";
                  pixel-size: 48;
                  accessible-role: presentation;
                }

                Label {
                  label: _("Library");

                  styles [
                    "heading",
                  ]
                }
              }
            };
          }

          // Where Steam is present: opens Steam Big Picture (`win.steam-big-picture`), and
          // shows that it is opening while the launcher waits for its window.
          Button big_picture_tile {
            visible: false;
            action-name: "win.steam-big-picture";

            styles [
              "card",
              "library-tile",
              "big-picture-tile",
            ]

            child: Overlay {
              child: Box big_picture_tile_frame {
                width-request: 320;
                height-request: 150;
              };

              [overlay]
              Box {
                orientation: vertical;
                spacing: 12;
                valign: center;

                Image big_picture_icon {
                  icon-name: "input-gaming-symbolic";
                  pixel-size: 48;
                  accessible-role: presentation;
                }

                Adw.Spinner big_picture_spinner {
                  visible: false;
                  width-request: 48;
                  height-request: 48;
                  halign: center;
                }

                // Steam's own name for it; the full "Steam Big Picture" shows as the
                // focused tile's title.
                Label {
                  label: _("Big Picture");
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                }

                Label big_picture_status {
                  visible: false;
                  label: _("Opening…");

                  styles [
                    "dimmed",
                  ]
                }
              }
            };
          }
        };
      }
    }
  };
}
