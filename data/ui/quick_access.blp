using Gtk 4.0;
using Adw 1;

// Fullscreen mode's Quick Access panel: R3 or the Deck's "…" button opens it, B closes it.
// The window hosts it as the sidebar of its `quick_access` split view; the rows' `win.*`
// actions are the ones `PinduQuickAccess::setup` adds to the host window, plus
// `win.playing-return`, `win.playing-stop` and `win.preview-navigation-sound`, which the
// host has.
template $PinduQuickAccess: Box {
  orientation: vertical;
  accessible-role: group;

  accessibility {
    label: _("Quick Access");
  }

  styles [
    "quick-access",
  ]

  // The status header over every level: the clock, "Offline" while there is no
  // network, and the battery on a machine that has one.
  Box {
    spacing: 18;
    margin-bottom: 18;

    styles [
      "quick-access-status",
    ]

    Label clock {
      xalign: 0;
      hexpand: true;

      styles [
        "clock",
        "numeric",
      ]
    }

    Box offline {
      spacing: 6;
      visible: false;
      tooltip-text: _("Artwork downloads wait until you are online");

      styles [
        "offline",
      ]

      Image {
        icon-name: "network-offline-symbolic";
        accessible-role: presentation;
      }

      Label {
        label: _("Offline");
      }
    }

    Box battery {
      spacing: 6;
      visible: false;

      styles [
        "battery",
      ]

      Image battery_icon {
        accessible-role: presentation;
      }

      Label battery_level {
        styles [
          "numeric",
        ]
      }
    }
  }

  Stack stack {
    vexpand: true;
    transition-type: crossfade;

    // The sections: the strip, then the shown section's page, which scrolls by itself.
    // A level replaces both while it shows.
    StackPage {
      name: "main";

      child: Box {
        orientation: vertical;
        spacing: 12;

        // A toggle per section, the shown one checked and named. The pointer and touch
        // press them; the controller's focus never lands on them (LB and RB switch
        // section), so Up from a section's first item stops there.
        Box section_strip {
          spacing: 0;
          accessible-role: tab_list;

          accessibility {
            label: _("Sections");
          }

          styles [
            "panel-sections",
          ]

          ToggleButton quick_tab {
            hexpand: bind quick_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'quick'";
            tooltip-text: _("Quick");

            accessibility {
              label: _("Quick");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "view-grid-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Quick");
                visible: bind quick_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }
            };
          }

          ToggleButton notifications_tab {
            hexpand: bind notifications_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'notifications'";
            tooltip-text: _("Notifications");

            accessibility {
              label: _("Notifications");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "preferences-system-notifications-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Notifications");
                visible: bind notifications_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }

              Label unread {
                visible: false;
                valign: center;

                styles [
                  "notification-count",
                  "numeric",
                ]
              }
            };
          }

          ToggleButton design_tab {
            hexpand: bind design_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'design'";
            tooltip-text: _("Design");

            accessibility {
              label: _("Design");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "preferences-desktop-appearance-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Design");
                visible: bind design_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }
            };
          }

          ToggleButton controller_tab {
            hexpand: bind controller_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'controller'";
            tooltip-text: _("Controller");

            accessibility {
              label: _("Controller");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "input-gaming-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Controller");
                visible: bind controller_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }
            };
          }

          ToggleButton system_tab {
            hexpand: bind system_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'system'";
            tooltip-text: _("System");

            accessibility {
              label: _("System");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "preferences-system-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("System");
                visible: bind system_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }
            };
          }

          ToggleButton manage_tab {
            hexpand: bind manage_tab.active;
            can-focus: false;
            focus-on-click: false;
            accessible-role: tab;
            action-name: "win.quick-access-section";
            action-target: "'manage'";
            tooltip-text: _("Manage");

            accessibility {
              label: _("Manage");
            }

            styles [
              "panel-section",
              "flat",
            ]

            child: Box {
              spacing: 4;
              halign: center;

              Image {
                icon-name: "view-list-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Manage");
                visible: bind manage_tab.active;
                ellipsize: end;
                max-width-chars: 20;
              }
            };
          }
        }

        Stack sections {
          vexpand: true;
          transition-type: crossfade;

          StackPage {
            name: "quick";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: quick_tab;
              }

              // How Up, Down, Left and Right move through the section is the section's own
              // (`PinduQuickSection`), not GTK's.
              child: $PinduQuickSection quick_section {
                orientation: vertical;
                spacing: 12;

                // The same Playing Now cards as the drawer's.
                Box playing_cards {
                  orientation: vertical;
                  spacing: 12;
                  visible: false;
                }

                // Shown while fullscreen mode's library is under the panel; its second
                // line names the filters that are on.
                Button filters_card {
                  action-name: "win.quick-access-filters";
                  visible: false;

                  styles [
                    "page-card",
                  ]

                  child: Box {
                    spacing: 12;

                    Image {
                      icon-name: "checkbox-checked-symbolic";
                      valign: center;
                      accessible-role: presentation;

                      styles [
                        "page-card-icon",
                      ]
                    }

                    Box {
                      orientation: vertical;
                      valign: center;
                      hexpand: true;

                      Label {
                        label: _("For This Page");
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "page-card-eyebrow",
                          "caption",
                          "dim-label",
                        ]
                      }

                      Label {
                        label: _("Filters");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        lines: 2;
                        ellipsize: end;

                        styles [
                          "heading",
                        ]
                      }
                    }

                    Label filters_card_state {
                      visible: false;
                      xalign: 1;
                      ellipsize: end;
                      max-width-chars: 24;

                      styles [
                        "page-card-state",
                        "dim-label",
                      ]
                    }

                    Image {
                      icon-name: "go-next-symbolic";
                      accessible-role: presentation;
                    }
                  };
                }

                // Shown while a game we run ourselves has focus under the panel, or the page is its
                // own; named as the level is.
                Button performance_card {
                  action-name: "win.quick-access-performance";
                  visible: false;

                  styles [
                    "page-card",
                  ]

                  child: Box {
                    spacing: 12;

                    Image {
                      icon-name: "power-profile-performance-symbolic";
                      valign: center;
                      accessible-role: presentation;

                      styles [
                        "page-card-icon",
                      ]
                    }

                    Box {
                      orientation: vertical;
                      valign: center;
                      hexpand: true;

                      Label {
                        label: _("For This Page");
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "page-card-eyebrow",
                          "caption",
                          "dim-label",
                        ]
                      }

                      Label {
                        label: bind performance_title.label;
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        lines: 2;
                        ellipsize: end;

                        styles [
                          "heading",
                        ]
                      }
                    }

                    Image {
                      icon-name: "go-next-symbolic";
                      accessible-role: presentation;
                    }
                  };
                }

                // Three equal columns, filled from the start with the tiles that show
                // (`pindu_core::panels::quick_tiles`), placed in code. A tile's top
                // expands inside it, not the grid inside the page.
                Grid quick_tiles {
                  column-spacing: 10;
                  row-spacing: 10;
                  column-homogeneous: true;
                  vexpand: false;

                  styles [
                    "quick-tiles",
                  ]

                  // As System's Sound Output row: the same level and second line.
                  Button quick_sound_output_tile {
                    action-name: "win.quick-access-sound-output";
                    visible: false;
                    sensitive: bind sound_output_row.sensitive;

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: "audio-volume-high-symbolic";
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }

                        Image {
                          icon-name: "go-next-symbolic";
                          valign: start;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-arrow",
                          ]
                        }
                      }

                      Label {
                        label: _("Sound Output");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }

                      Label {
                        label: bind sound_output_subtitle.label;
                        visible: bind sound_output_subtitle.visible;
                        xalign: 0;
                        ellipsize: end;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-state",
                          "caption",
                          "dim-label",
                        ]
                      }
                    };
                  }

                  // As System's Bluetooth row: the same level and second line.
                  Button quick_bluetooth_tile {
                    action-name: "win.quick-access-bluetooth";
                    visible: false;
                    sensitive: bind bluetooth_row.sensitive;

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: "bluetooth-active-symbolic";
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }

                        Image {
                          icon-name: "go-next-symbolic";
                          valign: start;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-arrow",
                          ]
                        }
                      }

                      Label {
                        label: _("Bluetooth");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }

                      Label {
                        label: bind bluetooth_subtitle.label;
                        xalign: 0;
                        ellipsize: end;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-state",
                          "caption",
                          "dim-label",
                        ]
                      }
                    };
                  }

                  // As System's Network row: the same level and second line.
                  Button quick_network_tile {
                    action-name: "win.quick-access-network";
                    visible: false;
                    sensitive: bind network_row.sensitive;

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: bind network_icon.icon-name;
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }

                        Image {
                          icon-name: "go-next-symbolic";
                          valign: start;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-arrow",
                          ]
                        }
                      }

                      Label {
                        label: _("Network");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }

                      Label {
                        label: bind network_subtitle.label;
                        xalign: 0;
                        ellipsize: end;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-state",
                          "caption",
                          "dim-label",
                        ]
                      }
                    };
                  }

                  // Opens a random installed game's page; unavailable while none is installed.
                  Button surprise_tile {
                    action-name: "win.surprise-me";

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: "media-playlist-shuffle-symbolic";
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }
                      }

                      Label {
                        label: _("Surprise Me");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }
                    };
                  }

                  // As Manage's Refresh Library, unavailable while a sync runs.
                  Button quick_refresh_tile {
                    action-name: "app.import";
                    sensitive: bind refresh_row.sensitive;

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: "view-refresh-symbolic";
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }
                      }

                      Label {
                        label: _("Refresh Library");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }
                    };
                  }

                  // As Manage's Add a Game.
                  Button quick_add_game_tile {
                    action-name: "win.add-game-fullscreen";

                    styles [
                      "quick-tile",
                    ]

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      Box {
                        valign: start;
                        vexpand: true;

                        Image {
                          icon-name: "applications-games-symbolic";
                          halign: start;
                          hexpand: true;
                          accessible-role: presentation;

                          styles [
                            "quick-tile-icon",
                          ]
                        }
                      }

                      Label {
                        label: _("Add a Game");
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        max-width-chars: 10;

                        styles [
                          "quick-tile-name",
                        ]
                      }
                    };
                  }
                }

                // While something runs in the background: the oldest task, its progress and
                // percentage; it shows the Notifications section, which lists the tasks with
                // Cancel.
                Button activity_strip {
                  visible: false;

                  styles [
                    "activity-strip",
                  ]

                  child: Box {
                    orientation: vertical;
                    spacing: 8;

                    Box {
                      spacing: 12;

                      Label activity_strip_label {
                        xalign: 0;
                        hexpand: true;
                        ellipsize: end;
                      }

                      Label activity_strip_percent {
                        visible: false;

                        styles [
                          "numeric",
                          "dim-label",
                        ]
                      }
                    }

                    ProgressBar activity_strip_bar {
                      pulse-step: 0.1;
                    }
                  };
                }
              };
            };
          }

          StackPage {
            name: "notifications";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: notifications_tab;
              }

              child: Box {
                orientation: vertical;
                spacing: 12;

                // While something runs in the background (a sync, an art fetch or a
                // Proton download): what runs, oldest first, each with its progress
                // and Cancel where it can be cancelled; filled in code. Siblings of
                // the notifications, so Up and Down go from one list to the other.
                Label running_title {
                  label: _("Running");
                  xalign: 0;
                  visible: false;

                  styles [
                    "heading",
                  ]
                }

                ListBox activity {
                  selection-mode: none;
                  visible: false;

                  styles [
                    "boxed-list",
                  ]
                }

                Label notifications_title {
                  label: _("Notifications");
                  xalign: 0;
                  margin-top: 6;
                  visible: bind running_title.visible;

                  styles [
                    "heading",
                  ]
                }

                // What happened this session, newest first, or that nothing has;
                // filled in code.
                ListBox notifications {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }
              };
            };
          }

          StackPage {
            name: "design";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: design_tab;
              }

              child: Box {
                orientation: vertical;
                spacing: 12;

                // Default, then each installed design, with a check on the one in
                // force; filled in code.
                ListBox designs {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }

                // The variants of the design in force, with a check on the one in
                // force; filled in code, and hidden for a design without variants.
                Label variant_title {
                  label: _("Variant");
                  xalign: 0;
                  margin-top: 6;
                  visible: false;

                  styles [
                    "heading",
                  ]
                }

                ListBox variants {
                  selection-mode: none;
                  visible: false;

                  styles [
                    "boxed-list",
                  ]
                }

                // Choice rows on the settings' actions, their options set in code.
                // Background shows only while the design in force offers the choice
                // (`home-background-choice`).
                ListBox design_choices {
                  selection-mode: none;
                  margin-top: 6;

                  styles [
                    "boxed-list",
                  ]

                  $PinduChoiceRow background_row {
                    title: _("Background");
                    visible: false;
                  }

                  $PinduChoiceRow blur_row {
                    title: _("Background Blur");
                  }

                  $PinduChoiceRow dim_row {
                    title: _("Background Dim");
                  }
                }

                // On the `fullscreen-custom-style` setting; insensitive, saying
                // where the file goes, while there is no `fullscreen.css`.
                ListBox custom_style {
                  selection-mode: none;
                  margin-top: 6;

                  styles [
                    "boxed-list",
                  ]

                  Adw.SwitchRow custom_style_row {
                    title: _("My Stylesheet");
                  }
                }
              };
            };
          }

          StackPage {
            name: "controller";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: controller_tab;
              }

              child: Box {
                orientation: vertical;
                spacing: 12;

                // Each connected controller with the glyphs it shows and its
                // battery; selecting one rumbles it, and one that cannot rumble is
                // unavailable. Filled in code, and again as controllers come and go.
                ListBox controllers {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }

                // Choice rows on the settings' actions, their options set in code. The
                // repeat and dead-zone rows change how the launcher moves its own focus; a
                // game receives the controller unchanged.
                ListBox controller_choices {
                  selection-mode: none;
                  margin-top: 6;

                  styles [
                    "boxed-list",
                  ]

                  $PinduChoiceRow prompts_row {
                    title: _("Button Prompts");
                  }

                  $PinduChoiceRow swap_row {
                    title: _("Swap Confirm and Back");
                  }

                  $PinduChoiceRow repeat_delay_row {
                    title: _("Repeat Delay");
                  }

                  $PinduChoiceRow repeat_rate_row {
                    title: _("Repeat Rate");
                  }

                  $PinduChoiceRow dead_zone_row {
                    title: _("Stick Dead Zone");
                  }
                }

                Label {
                  label: _("These change only how focus moves here. Games receive the controller unchanged.");
                  xalign: 0;
                  wrap: true;

                  styles [
                    "dim-label",
                  ]
                }

                // What each button and key does.
                ListBox controller_list {
                  margin-top: 6;
                  selection-mode: none;

                  styles [
                    "navigation-sidebar",
                  ]

                  ListBoxRow controls_row {
                    action-name: "win.quick-access-controls";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "help-browser-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Controls");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }
                }
              };
            };
          }

          StackPage {
            name: "system";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: system_tab;
              }

              child: Box {
                orientation: vertical;
                spacing: 12;

                // Network, Bluetooth, Sound Output and System Update where available, Settings,
                // and the diagnostics report but over a running game.
                ListBox system_list {
                  selection-mode: none;

                  styles [
                    "navigation-sidebar",
                  ]

                  // Shown where NetworkManager runs: the connection in use, or that
                  // the system does not allow changing it (then insensitive).
                  ListBoxRow network_row {
                    action-name: "win.quick-access-network";
                    visible: false;

                    child: Box {
                      spacing: 16;

                      Image network_icon {
                        icon-name: "network-wired-symbolic";
                        accessible-role: presentation;
                      }

                      Box {
                        orientation: vertical;
                        valign: center;
                        hexpand: true;

                        Label {
                          label: _("Network");
                          xalign: 0;
                        }

                        Label network_subtitle {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // Shown where BlueZ has an adapter: the connected devices, or how
                  // the radio is.
                  ListBoxRow bluetooth_row {
                    action-name: "win.quick-access-bluetooth";
                    visible: false;

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "bluetooth-active-symbolic";
                        accessible-role: presentation;
                      }

                      Box {
                        orientation: vertical;
                        valign: center;
                        hexpand: true;

                        Label {
                          label: _("Bluetooth");
                          xalign: 0;
                        }

                        Label bluetooth_subtitle {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // Shown where PipeWire's tools run and find an output, with the
                  // output in use under it.
                  ListBoxRow sound_output_row {
                    action-name: "win.quick-access-sound-output";
                    visible: false;

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "audio-volume-high-symbolic";
                        accessible-role: presentation;
                      }

                      Box {
                        orientation: vertical;
                        valign: center;
                        hexpand: true;

                        Label {
                          label: _("Sound Output");
                          xalign: 0;
                        }

                        Label sound_output_subtitle {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // Shown on Pindu OS: the installed version, or that an update waits
                  // for the next start.
                  ListBoxRow system_update_row {
                    action-name: "win.quick-access-system-update";
                    visible: false;

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "software-update-available-symbolic";
                        accessible-role: presentation;
                      }

                      Box {
                        orientation: vertical;
                        valign: center;
                        hexpand: true;

                        Label {
                          label: _("System Update");
                          xalign: 0;
                        }

                        Label system_update_subtitle {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  ListBoxRow settings_row {
                    action-name: "win.quick-access-settings";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "preferences-system-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Settings");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // The diagnostics report, to photograph a page at a time; a copy is
                  // saved as it opens.
                  ListBoxRow report_row {
                    action-name: "win.quick-access-diagnostics-report";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "dialog-information-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Diagnostics Report");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }
                }
              };
            };
          }

          StackPage {
            name: "manage";

            child: ScrolledWindow {
              hscrollbar-policy: never;
              accessible-role: tab_panel;

              accessibility {
                labelled-by: manage_tab;
              }

              child: Box {
                orientation: vertical;
                spacing: 12;

                // The library's upkeep; Add a Store and Add a Game but over a running game.
                ListBox manage_list {
                  selection-mode: none;

                  styles [
                    "navigation-sidebar",
                  ]

                  ListBoxRow sources_row {
                    action-name: "win.quick-access-sources";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "folder-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Sources");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  ListBoxRow duplicates_row {
                    action-name: "win.quick-access-duplicates";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "edit-copy-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Duplicates");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // The Library Health report, subtitled with how many problems need
                  // attention.
                  ListBoxRow health_row {
                    action-name: "win.quick-access-library-health";

                    child: Box {
                      spacing: 16;

                      Image health_icon {
                        icon-name: "emblem-ok-symbolic";
                        accessible-role: presentation;
                      }

                      Box {
                        orientation: vertical;
                        valign: center;
                        hexpand: true;

                        Label {
                          label: _("Library Health");
                          xalign: 0;
                        }

                        Label health_subtitle {
                          xalign: 0;
                          ellipsize: end;
                          visible: false;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // The Proton builds to download and remove, and the defaults for
                  // new Windows games.
                  ListBoxRow proton_row {
                    action-name: "win.quick-access-proton";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "folder-download-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Proton");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // The "add a store" flow, which installs Steam, Heroic or Lutris.
                  ListBoxRow add_store_row {
                    action-name: "win.quick-access-add-store";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "list-add-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Add a Store");
                        xalign: 0;
                        hexpand: true;
                      }

                      Image {
                        icon-name: "go-next-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }

                  // Fullscreen mode's Add Game, a dialog over the main window.
                  ListBoxRow add_game_row {
                    action-name: "win.add-game-fullscreen";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "applications-games-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Add a Game");
                        xalign: 0;
                        hexpand: true;
                      }
                    };
                  }

                  // The same sync as Import, unavailable while one runs.
                  ListBoxRow refresh_row {
                    action-name: "app.import";

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "view-refresh-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Refresh Library");
                        xalign: 0;
                        hexpand: true;
                      }
                    };
                  }

                  // A Wikidata refresh, shown only while Wikidata metadata is on.
                  ListBoxRow refresh_metadata_row {
                    action-name: "app.refresh-metadata";
                    visible: false;

                    child: Box {
                      spacing: 16;

                      Image {
                        icon-name: "text-x-generic-symbolic";
                        accessible-role: presentation;
                      }

                      Label {
                        label: _("Refresh Metadata");
                        xalign: 0;
                        hexpand: true;
                      }
                    };
                  }
                }
              };
            };
          }
        }
      };
    }

    StackPage {
      name: "controls";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Controls");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          // What each button and key does, a heading and a list per group,
          // with the glyphs of the controller in use or the keys alone
          // without one. Filled in code, and again as the controller changes.
          Box controls {
            orientation: vertical;
            spacing: 12;
          }
        };
      };
    }

    StackPage {
      name: "settings";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Settings");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          // Cover Size and Text Size are choice rows (`PinduChoiceRow`): Left and Right
          // change them in place, where a drop-down's popover would be dismissed by a
          // controller press, and radio rows or toggles side by side take a stop each.
          ListBox sizes {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            $PinduChoiceRow cover_size_row {
              title: _("Cover Size");
            }

            $PinduChoiceRow text_size_row {
              title: _("Text Size");
            }
          }

          ListBox switches {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.SwitchRow sounds_row {
              title: _("Navigation Sounds");
            }

            // The slider takes focus rather than its row, so left and right
            // turn it; the row goes insensitive while the sounds are off.
            Adw.ActionRow volume_row {
              title: _("Volume");
              activatable: false;
              focusable: false;

              [suffix]
              Scale volume {
                hexpand: true;
                digits: 0;
                draw-value: false;

                adjustment: Adjustment {
                  lower: 0;
                  upper: 100;
                  step-increment: 5;
                  page-increment: 20;
                };

                accessibility {
                  label: _("Navigation Sound Volume");
                }
              }
            }

            Adw.SwitchRow exit_row {
              title: _("Exit After Launching");
            }
          }

          Label {
            label: _("Accessibility");
            xalign: 0;
            margin-top: 6;

            styles [
              "heading",
            ]
          }

          ListBox accessibility {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.SwitchRow reduce_motion_row {
              title: _("Reduce Motion");
            }

            Adw.SwitchRow hold_to_confirm_row {
              title: _("Hold to Confirm");
            }
          }

          Label {
            label: _("Artwork");
            xalign: 0;
            margin-top: 6;

            styles [
              "heading",
            ]
          }

          // The key is typed hidden with the on-screen keyboard and kept in the
          // keyring; the row's subtitle says whether one is stored, or why the
          // keyring cannot be used.
          ListBox artwork {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ActionRow steamgriddb_key_row {
              title: _("SteamGridDB Key");
              activatable: true;
            }

            Adw.SwitchRow prefer_steamgriddb_row {
              title: _("Prefer SteamGridDB Art");
              subtitle: _("Show it before the launcher's own art; art you pick always comes first");
            }
          }

          Label {
            label: _("Metadata");
            xalign: 0;
            margin-top: 6;

            styles [
              "heading",
            ]
          }

          // On, Refresh Metadata shows in the main list.
          ListBox metadata {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.SwitchRow wikidata_row {
              title: _("Get Metadata From Wikidata");
              subtitle: _("Nothing is fetched until you ask, and never during an import");
            }
          }
        };
      };
    }

    StackPage {
      name: "sources";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Sources");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          // Each imported source with whether it was found on this computer and
          // its Import switch, the setting Preferences, Sources changes. Filled in
          // code as the level opens and after each sync.
          ListBox sources {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }

          Label {
            label: _("Copy Order");
            xalign: 0;
            margin-top: 6;

            styles [
              "heading",
            ]
          }

          Label {
            label: _("When a game has copies from several sources and you chose none, Play starts the installed copy from the source highest here. Native copies still come before Windows ones.");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          // The source order a game's copies follow, the setting Preferences,
          // Sources changes: each row's Move Up and Move Down are reached with
          // Right. Filled in code.
          ListBox source_order {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }
        };
      };
    }

    StackPage {
      name: "duplicates";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Duplicates");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          // Shown while there is nothing to review.
          Label duplicates_empty {
            label: _("No copies of one game to review");
            xalign: 0;
            wrap: true;
            visible: false;

            styles [
              "dim-label",
            ]
          }

          // Each suggestion, opening to Group and Not the Same Game, then each
          // group the sync made, opening to Undo. Filled in code as the level
          // opens, after each sync and after each choice.
          ListBox duplicates {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }
        };
      };
    }

    StackPage {
      name: "filters";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Filters");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          // Fullscreen mode's own filters, apart from the desktop window's
          // filter row; they narrow every tab as they change.
          ListBox filters {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.SwitchRow installed_row {
              title: _("Installed");
            }

            Adw.SwitchRow not_installed_row {
              title: _("Not Installed");
            }

            Adw.SwitchRow windows_row {
              title: _("Windows");
            }

            Adw.SwitchRow native_row {
              title: _("Native");
            }

            Adw.SwitchRow never_played_row {
              title: _("Never Played");
            }

            Adw.SwitchRow hidden_row {
              title: _("Show Hidden Games");
            }
          }

          Label {
            label: _("Genre");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          // Any Genre, then each genre of the library, with a check on the one chosen;
          // filled as the panel shows Filters.
          ListBox genres {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }

          ListBox clear_filters {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ButtonRow {
              title: _("Clear Filters");
              action-name: "win.clear-fullscreen-filters";
            }
          }

          // Saves the shown tab with these filters and the search as a collection whose
          // games are computed, or saves a suggested one.
          ListBox save_filters {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ButtonRow {
              title: _("Save Filter…");
              action-name: "win.save-filter";
            }

            Adw.ButtonRow {
              title: _("Save Native Games");
              action-name: "win.save-suggestion";
              action-target: "'native'";
            }

            Adw.ButtonRow {
              title: _("Save Windows Games");
              action-name: "win.save-suggestion";
              action-target: "'windows'";
            }

            Adw.ButtonRow {
              title: _("Save Installed and Never Played");
              action-name: "win.save-suggestion";
              action-target: "'installed-never-played'";
            }
          }
        };
      };
    }

    StackPage {
      name: "performance";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          // "Performance for <the game>".
          Label performance_title {
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;

            styles [
              "title-3",
            ]
          }

          // The game's own launch settings, the same as its options sheet's.
          ListBox performance {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.SwitchRow overlay_row {
              title: _("Performance Overlay");
              subtitle: _("MangoHud");
            }

            Adw.SwitchRow gamemode_row {
              title: _("GameMode");
              subtitle: _("Asks the system to favour the game while it runs");
            }
          }

          // The game's Proton build, for a game Pindu runs through Proton: the
          // default, then the builds on this machine, newest first, with a check
          // on the game's; filled in code, and hidden for other games.
          Label proton_title {
            label: _("Proton");
            xalign: 0;
            margin-top: 6;
            visible: false;

            styles [
              "heading",
            ]
          }

          ListBox proton_builds {
            selection-mode: none;
            visible: false;

            styles [
              "boxed-list",
            ]
          }

          // Shown while the game runs.
          Label performance_note {
            label: _("Changes apply the next time the game starts.");
            xalign: 0;
            wrap: true;
            visible: false;

            styles [
              "dim-label",
            ]
          }
        };
      };
    }

    StackPage {
      name: "sound-output";

      child: $PinduSoundOutputLevel sound_output_level {};
    }

    StackPage {
      name: "system-update";

      child: $PinduSystemUpdateLevel system_update_level {};
    }

    StackPage {
      name: "library-health";

      child: $PinduHealthLevel health_level {};
    }

    StackPage {
      name: "add-store";

      child: $PinduAddStoreLevel add_store_level {};
    }

    StackPage {
      name: "diagnostics-report";

      child: $PinduReportLevel report_level {};
    }

    StackPage {
      name: "report-log";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Add a Game's Log");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          Label {
            label: _("The game's newest log is added to the report. The report keeps that game's title; other titles and your home folder stay out.");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          // The games with a log, the game played with logs last first, each with
          // its newest log's name; filled in code as the level opens.
          ListBox report_logs {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }

          // Shown when no game has a log.
          Label report_logs_empty {
            label: _("No game has a log yet: start one with Play with Logs");
            xalign: 0;
            wrap: true;
            visible: false;
          }
        };
      };
    }

    StackPage {
      name: "proton";

      child: $PinduProtonLevel proton_level {};
    }

    StackPage {
      name: "network";

      child: $PinduNetworkLevel network_level {};
    }

    StackPage {
      name: "bluetooth";

      child: $PinduBluetoothLevel bluetooth_level {};
    }
  }
}
