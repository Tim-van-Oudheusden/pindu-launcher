using Gtk 4.0;
using Adw 1;

template $PinduGamePage: Adw.NavigationPage {
  tag: "game";

  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      show-title: false;
    }

    [top]
    Adw.Banner permission_banner {
      title: _("Starting this game needs your permission");
      button-label: _("How to Enable");
      action-name: "app.preferences";
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Box {
        orientation: vertical;

        Overlay {
          styles [
            "game-hero",
          ]

          child: Picture hero {
            content-fit: cover;
            height-request: 320;
            can-shrink: true;
          };

          [overlay]
          Box {
            can-target: false;

            styles [
              "hero-gradient",
            ]
          }

          [overlay]
          Box {
            halign: start;
            valign: end;
            margin-start: 32;
            margin-end: 32;
            margin-bottom: 24;

            Picture logo {
              visible: false;
              content-fit: contain;
              width-request: 320;
              height-request: 120;
              can-shrink: true;
              halign: start;
            }

            Label title {
              wrap: true;
              xalign: 0;

              styles [
                "title-1",
              ]
            }
          }
        }

        Adw.Clamp {
          maximum-size: 900;
          margin-start: 24;
          margin-end: 24;
          margin-bottom: 32;

          child: Box {
            orientation: vertical;
            spacing: 24;

            Box {
              spacing: 12;

              Button play_button {
                label: _("_Play");
                use-underline: true;
                action-name: "app.play";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Button favourite_button {
                icon-name: "non-starred-symbolic";
                tooltip-text: _("Add to Favourites");
                valign: center;
                action-name: "win.toggle-favourite";

                styles [
                  "circular",
                ]
              }

              MenuButton more_button {
                icon-name: "view-more-symbolic";
                tooltip-text: _("More Actions");
                valign: center;

                styles [
                  "circular",
                ]
              }
            }

            Adw.WrapBox facts {
              child-spacing: 32;
              line-spacing: 12;
            }

            Adw.PreferencesGroup about_group {
              title: _("About");

              Adw.ActionRow developer_row {
                title: _("Developer");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow genres_row {
                title: _("Genres");

                styles [
                  "property",
                ]
              }
            }

            Label description {
              wrap: true;
              xalign: 0;
              selectable: true;
            }

            Adw.PreferencesGroup launch_group {
              title: _("Launch");

              Adw.ActionRow launch_row {
                title: _("Started by the launcher");

                [suffix]
                Button open_in_launcher {
                  valign: center;
                  action-name: "app.open-in-launcher";
                }
              }

              Adw.SwitchRow steam_dialog_row {
                title: _("Choose Launch Options");
                subtitle: _("Ask Steam which of the game’s launch options to use");
                visible: false;
              }
            }

            Adw.PreferencesGroup settings_group {
              title: _("Launch");
              description: _("Changes apply the next time the game starts.");
              visible: false;

              Adw.ComboRow proton_row {
                title: _("Proton");

                model: StringList {};
              }

              Adw.ActionRow prefix_row {
                title: _("Prefix");
                subtitle-selectable: true;

                [suffix]
                Button {
                  label: _("C_hoose…");
                  use-underline: true;
                  valign: center;
                  clicked => $choose_prefix() swapped;
                }
              }

              Adw.EntryRow arguments_row {
                title: _("Arguments");
                show-apply-button: true;
                apply => $apply_arguments() swapped;
              }

              Adw.EntryRow environment_row {
                title: _("Environment, Such as NAME=value");
                show-apply-button: true;
                apply => $apply_environment() swapped;
              }

              Adw.SwitchRow mangohud_row {
                title: _("MangoHud");
                subtitle: _("An overlay with the frame rate and how busy the computer is");
              }

              Adw.SwitchRow gamemode_row {
                title: _("GameMode");
                subtitle: _("Asks the system to favour the game while it runs");
              }

              Adw.EntryRow wrappers_row {
                title: _("Wrapper Command, Such as taskset -c 0-3");
                show-apply-button: true;
                apply => $apply_wrappers() swapped;
              }
            }
          };
        }
      };
    };
  };
}
