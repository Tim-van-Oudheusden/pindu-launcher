using Gtk 4.0;
using Adw 1;

// Quick Access over a running game in a `--steam` gamescope: an undecorated, see-through
// window that gamescope sizes to the screen and composites over the game while it is open.
// The panel sits on the right as it does in the main window, with the hint bar under it;
// the game shows on the left, and a click there closes the panel. The rows' `win.*`
// actions are the ones `PinduQuickAccess::setup` adds to this window, plus the ones
// `quick_access_overlay` hands on to the main window.
template $PinduQuickAccessOverlay: Adw.Window {
  title: _("Quick Access");
  decorated: false;

  styles [
    "quick-access-overlay",
  ]

  content: Box {
    Box shade {
      hexpand: true;
    }

    Box {
      orientation: vertical;
      width-request: 440;

      styles [
        "sidebar-pane",
      ]

      $PinduQuickAccess quick_access {
        vexpand: true;
      }

      Box hint_bar {
        halign: end;
        spacing: 24;

        styles [
          "hint-bar",
        ]
      }
    }
  };
}
