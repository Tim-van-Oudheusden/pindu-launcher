using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Search");
      accelerator: "<primary>f";
    }

    Adw.ShortcutsItem {
      title: _("Add Game");
      accelerator: "<primary>n";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<primary>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<primary>question";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<primary>q";
    }
  }

  Adw.ShortcutsSection {
    title: _("Library");

    Adw.ShortcutsItem {
      title: _("Toggle Sidebar");
      accelerator: "F9";
    }

    Adw.ShortcutsItem {
      title: _("Show Hidden Games");
      accelerator: "<primary>h";
    }

    Adw.ShortcutsItem {
      title: _("Play or Open the Focused Game");
      accelerator: "Return";
    }

    Adw.ShortcutsItem {
      title: _("Remove the Focused Game");
      accelerator: "Delete";
    }

    Adw.ShortcutsItem {
      title: _("Back");
      accelerator: "<alt>Left";
    }

    Adw.ShortcutsItem {
      title: _("Open the Focused Game's Menu");
      accelerator: "Menu <shift>F10";
    }

    Adw.ShortcutsItem {
      title: _("Fullscreen Mode");
      accelerator: "F11";
    }
  }

  Adw.ShortcutsSection {
    title: _("Fullscreen Mode");

    Adw.ShortcutsItem {
      title: _("Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Quick Access");
      accelerator: "<primary>2";
    }

    Adw.ShortcutsItem {
      title: _("Options for the Focused Game");
      accelerator: "Menu <shift>F10";
    }

    Adw.ShortcutsItem {
      title: _("Previous or Next Tab");
      accelerator: "<primary>Page_Up <primary>Page_Down";
    }

    Adw.ShortcutsItem {
      title: _("Previous or Next Sort Order");
      accelerator: "<primary><shift>Page_Up <primary><shift>Page_Down";
    }
  }
}
