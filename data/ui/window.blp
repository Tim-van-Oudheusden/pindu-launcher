using Gtk 4.0;
using Adw 1;

template $PinduWindow: Adw.ApplicationWindow {
  title: _("Pindu launcher");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 730sp")

    setters {
      split_view.collapsed: true;
    }
  }

  // The hint bar shows what the controller's buttons do, in fullscreen mode.
  content: Adw.ToolbarView hint_toolbar {
    reveal-bottom-bars: false;

    content: Adw.ToastOverlay toast_overlay {
      // Fullscreen mode's panels: the options sheet at the bottom, the menu drawer on the
      // left and Quick Access on the right, over the pages.
      child: Adw.BottomSheet options_sheet {
        can-open: false;
        show-drag-handle: false;

        content: Adw.OverlaySplitView drawer {
          collapsed: true;
          show-sidebar: false;
          enable-show-gesture: false;
          max-sidebar-width: 440;
          sidebar-width-fraction: 0.4;

          // Fullscreen mode's menu drawer: Start or Guide opens it over the page, B closes it.
          sidebar: Box drawer_panel {
            orientation: vertical;
            accessible-role: group;

            accessibility {
              label: _("Menu");
            }

            styles [
              "menu-drawer",
            ]

            Stack drawer_stack {
              vexpand: true;
              transition-type: crossfade;

              StackPage {
                name: "main";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Box {
                    orientation: vertical;
                    spacing: 12;

                    // A card for each game we started that runs, with its session time,
                    // Return and Stop.
                    Box playing_cards {
                      orientation: vertical;
                      spacing: 12;
                      visible: false;
                    }

                    ListBox drawer_list {
                      selection-mode: none;

                      styles [
                        "navigation-sidebar",
                      ]

                      ListBoxRow {
                        action-name: "win.drawer-home";

                        child: Box {
                          spacing: 16;

                          Image {
                            icon-name: "go-home-symbolic";
                            accessible-role: presentation;
                          }

                          Label {
                            label: _("Home");
                            xalign: 0;
                          }
                        };
                      }

                      ListBoxRow {
                        action-name: "win.drawer-library";

                        child: Box {
                          spacing: 16;

                          Image {
                            icon-name: "view-grid-symbolic";
                            accessible-role: presentation;
                          }

                          Label {
                            label: _("Library");
                            xalign: 0;
                          }
                        };
                      }

                      ListBoxRow drawer_collections_row {
                        action-name: "win.drawer-collections";

                        child: Box {
                          spacing: 16;

                          Image {
                            icon-name: "folder-symbolic";
                            accessible-role: presentation;
                          }

                          Label {
                            label: _("Collections");
                            xalign: 0;
                            hexpand: true;
                          }

                          Image {
                            icon-name: "go-next-symbolic";
                            accessible-role: presentation;
                          }
                        };
                      }

                      ListBoxRow {
                        action-name: "win.leave-fullscreen";

                        child: Box {
                          spacing: 16;

                          Image {
                            icon-name: "view-restore-symbolic";
                            accessible-role: presentation;
                          }

                          Label {
                            label: _("Exit Fullscreen Mode");
                            xalign: 0;
                          }
                        };
                      }

                      ListBoxRow {
                        action-name: "app.quit";

                        child: Box {
                          spacing: 16;

                          Image {
                            icon-name: "application-exit-symbolic";
                            accessible-role: presentation;
                          }

                          Label {
                            label: _("Quit");
                            xalign: 0;
                          }
                        };
                      }
                    }
                  };
                };
              }

              StackPage {
                name: "collections";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Box {
                    orientation: vertical;
                    spacing: 12;

                    Label {
                      label: _("Collections");
                      xalign: 0;

                      styles [
                        "title-3",
                      ]
                    }

                    ListBox drawer_collections {
                      selection-mode: none;

                      styles [
                        "navigation-sidebar",
                      ]
                    }
                  };
                };
              }
            }
          };

          content: Adw.OverlaySplitView quick_access {
            collapsed: true;
            show-sidebar: false;
            sidebar-position: end;
            enable-show-gesture: false;
            max-sidebar-width: 440;
            sidebar-width-fraction: 0.4;

            // Fullscreen mode's Quick Access: R3 or the Deck's "…" button opens it over the
            // page, B closes it.
            sidebar: Box quick_access_panel {
              orientation: vertical;
              accessible-role: group;

              accessibility {
                label: _("Quick Access");
              }

              styles [
                "quick-access",
              ]

              // The status header over every level: the clock, "Offline" while there is no
              // network, and the battery on a machine that has one.
              Box {
                spacing: 18;
                margin-bottom: 18;

                styles [
                  "quick-access-status",
                ]

                Label quick_access_clock {
                  xalign: 0;
                  hexpand: true;

                  styles [
                    "clock",
                    "numeric",
                  ]
                }

                Box quick_access_offline {
                  spacing: 6;
                  visible: false;
                  tooltip-text: _("Artwork downloads wait until you are online");

                  styles [
                    "offline",
                  ]

                  Image {
                    icon-name: "network-offline-symbolic";
                    accessible-role: presentation;
                  }

                  Label {
                    label: _("Offline");
                  }
                }

                Box quick_access_battery {
                  spacing: 6;
                  visible: false;

                  styles [
                    "battery",
                  ]

                  Image quick_access_battery_icon {
                    accessible-role: presentation;
                  }

                  Label quick_access_battery_level {
                    styles [
                      "numeric",
                    ]
                  }
                }
              }

              Stack quick_access_stack {
                vexpand: true;
                transition-type: crossfade;

                StackPage {
                  name: "main";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;

                      // The same Playing Now cards as the drawer's.
                      Box quick_access_playing_cards {
                        orientation: vertical;
                        spacing: 12;
                        visible: false;
                      }

                      Label {
                        label: _("Quick Access");
                        xalign: 0;

                        styles [
                          "title-3",
                        ]
                      }

                      ListBox quick_access_list {
                        selection-mode: none;

                        styles [
                          "navigation-sidebar",
                        ]

                        // With the unread count, which clears once the level is opened.
                        ListBoxRow quick_access_notifications_row {
                          action-name: "win.quick-access-notifications";

                          child: Box {
                            spacing: 16;

                            Image {
                              icon-name: "preferences-system-notifications-symbolic";
                              accessible-role: presentation;
                            }

                            Label {
                              label: _("Notifications");
                              xalign: 0;
                              hexpand: true;
                            }

                            Label quick_access_unread {
                              visible: false;
                              valign: center;

                              styles [
                                "notification-count",
                                "numeric",
                              ]
                            }

                            Image {
                              icon-name: "go-next-symbolic";
                              accessible-role: presentation;
                            }
                          };
                        }

                        // Shown while something runs in the background: a sync, an art
                        // fetch or a Proton download.
                        ListBoxRow quick_access_activity_row {
                          action-name: "win.quick-access-activity";
                          visible: false;

                          child: Box {
                            spacing: 16;

                            Image {
                              icon-name: "emblem-synchronizing-symbolic";
                              accessible-role: presentation;
                            }

                            Label {
                              label: _("Activity");
                              xalign: 0;
                              hexpand: true;
                            }

                            Adw.Spinner {
                              valign: center;
                            }

                            Image {
                              icon-name: "go-next-symbolic";
                              accessible-role: presentation;
                            }
                          };
                        }

                        // The same sync as Import, unavailable while one runs.
                        ListBoxRow quick_access_refresh_row {
                          action-name: "app.import";

                          child: Box {
                            spacing: 16;

                            Image {
                              icon-name: "view-refresh-symbolic";
                              accessible-role: presentation;
                            }

                            Label {
                              label: _("Refresh Library");
                              xalign: 0;
                              hexpand: true;
                            }
                          };
                        }

                        ListBoxRow quick_access_design_row {
                          action-name: "win.quick-access-designs";

                          child: Box {
                            spacing: 16;

                            Image {
                              icon-name: "preferences-desktop-appearance-symbolic";
                              accessible-role: presentation;
                            }

                            Label {
                              label: _("Design");
                              xalign: 0;
                              hexpand: true;
                            }

                            Image {
                              icon-name: "go-next-symbolic";
                              accessible-role: presentation;
                            }
                          };
                        }

                        ListBoxRow quick_access_settings_row {
                          action-name: "win.quick-access-settings";

                          child: Box {
                            spacing: 16;

                            Image {
                              icon-name: "preferences-system-symbolic";
                              accessible-role: presentation;
                            }

                            Label {
                              label: _("Settings");
                              xalign: 0;
                              hexpand: true;
                            }

                            Image {
                              icon-name: "go-next-symbolic";
                              accessible-role: presentation;
                            }
                          };
                        }
                      }
                    };
                  };
                }

                StackPage {
                  name: "notifications";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;

                      Label {
                        label: _("Notifications");
                        xalign: 0;

                        styles [
                          "title-3",
                        ]
                      }

                      // What happened this session, newest first, or that nothing has;
                      // filled in code.
                      ListBox quick_access_notifications {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]
                      }
                    };
                  };
                }

                StackPage {
                  name: "activity";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;

                      Label {
                        label: _("Activity");
                        xalign: 0;

                        styles [
                          "title-3",
                        ]
                      }

                      // What runs, oldest first, each with its progress and Cancel where
                      // it can be cancelled; filled in code.
                      ListBox quick_access_activity {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]
                      }
                    };
                  };
                }

                StackPage {
                  name: "designs";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;

                      Label {
                        label: _("Design");
                        xalign: 0;

                        styles [
                          "title-3",
                        ]
                      }

                      // Default, then each installed design, with a check on the one in
                      // force; filled in code.
                      ListBox quick_access_designs {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]
                      }
                    };
                  };
                }

                StackPage {
                  name: "settings";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;

                      Label {
                        label: _("Settings");
                        xalign: 0;

                        styles [
                          "title-3",
                        ]
                      }

                      // Radio rows rather than a drop-down, whose popover a controller press
                      // would dismiss, or toggles side by side, which up and down step
                      // through.
                      ListBox quick_access_sizes {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]

                        Adw.ActionRow {
                          title: _("Small Covers");
                          activatable-widget: tile_small;

                          [prefix]
                          CheckButton tile_small {
                            can-focus: false;
                          }
                        }

                        Adw.ActionRow {
                          title: _("Medium Covers");
                          activatable-widget: tile_medium;

                          [prefix]
                          CheckButton tile_medium {
                            group: tile_small;
                            can-focus: false;
                          }
                        }

                        Adw.ActionRow {
                          title: _("Large Covers");
                          activatable-widget: tile_large;

                          [prefix]
                          CheckButton tile_large {
                            group: tile_small;
                            can-focus: false;
                          }
                        }
                      }

                      ListBox quick_access_switches {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]

                        Adw.SwitchRow quick_access_sounds_row {
                          title: _("Navigation Sounds");
                        }

                        Adw.SwitchRow quick_access_exit_row {
                          title: _("Exit After Launching");
                        }
                      }
                    };
                  };
                }
              }
            };

            content: Adw.OverlaySplitView split_view {
              sidebar: Adw.ToolbarView sidebar_toolbar {
                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle {
                    title: _("Pindu launcher");
                  };
                }

                content: Adw.Sidebar sidebar {
                  Adw.SidebarSection {
                    title: _("Library");

                    Adw.SidebarItem all_item {
                      title: _("All Games");
                      icon-name: "view-grid-symbolic";

                      suffix: Label all_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem installed_item {
                      title: _("Installed");
                      icon-name: "drive-harddisk-symbolic";

                      suffix: Label installed_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem favourites_item {
                      title: _("Favourites");
                      icon-name: "starred-symbolic";

                      suffix: Label favourites_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem history_item {
                      title: _("Play History");
                      icon-name: "document-open-recent-symbolic";

                      suffix: Label history_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }
                  }

                  Adw.SidebarSection sources_section {
                    title: _("Sources");
                  }

                  Adw.SidebarSection collections_section {
                    title: _("Collections");
                    menu-model: collection_menu;
                  }

                  Adw.SidebarSection {
                    Adw.SidebarItem new_collection_item {
                      title: _("New Collection");
                      icon-name: "list-add-symbolic";
                    }
                  }
                };
              };

              // Fullscreen mode's top bar, which a design turns on: tabs for Home and the
              // library, and a clock. Home's backdrop runs on under it.
              content: Adw.ToolbarView top_bar_view {
                [top]
                Box top_bar {
                  visible: false;
                  spacing: 24;
                  margin-top: 18;
                  margin-start: 36;
                  margin-end: 36;

                  styles [
                    "fullscreen-top-bar",
                  ]

                  Box {
                    spacing: 6;
                    hexpand: true;

                    ToggleButton {
                      label: _("Home");
                      action-name: "win.show-page";
                      action-target: "'home'";

                      styles [
                        "page-tab",
                      ]
                    }

                    ToggleButton {
                      label: _("Library");
                      action-name: "win.show-page";
                      action-target: "'library'";

                      styles [
                        "page-tab",
                      ]
                    }
                  }

                  Label clock {
                    styles [
                      "clock",
                      "numeric",
                    ]
                  }
                }

                content: Adw.NavigationView navigation_view {
                  Adw.NavigationPage library_page {
                    title: _("All Games");
                    tag: "library";

                    child: Adw.ToolbarView {
                      [top]
                      Adw.HeaderBar {
                        [start]
                        ToggleButton sidebar_toggle {
                          icon-name: "sidebar-show-symbolic";
                          tooltip-text: _("Toggle Sidebar");
                          active: bind split_view.show-sidebar bidirectional;
                        }

                        [start]
                        MenuButton {
                          icon-name: "list-add-symbolic";
                          tooltip-text: _("Add");
                          menu-model: add_menu;
                        }

                        [start]
                        Adw.Spinner sync_spinner {
                          visible: false;
                          tooltip-text: _("Importing Games…");
                        }

                        title-widget: SearchEntry search_entry {
                          placeholder-text: _("Search games");
                          hexpand: true;
                          max-width-chars: 32;

                          accessibility {
                            label: _("Search games");
                          }
                        };

                        [end]
                        MenuButton {
                          primary: true;
                          icon-name: "open-menu-symbolic";
                          tooltip-text: _("Main Menu");
                          menu-model: primary_menu;
                        }

                        [end]
                        MenuButton {
                          icon-name: "view-sort-descending-symbolic";
                          tooltip-text: _("Sort");
                          menu-model: sort_menu;
                        }
                      }

                      content: Box {
                        orientation: vertical;

                        // Fullscreen mode's tabs, which the shoulder buttons switch, and the sort
                        // order, which the triggers cycle; the filter row hides meanwhile. Focus
                        // stays on the page below them.
                        Box library_tabs {
                          visible: false;
                          can-focus: false;
                          spacing: 24;
                          margin-top: 24;
                          margin-bottom: 12;
                          margin-start: 36;
                          margin-end: 36;

                          styles [
                            "library-tabs",
                          ]

                          ScrolledWindow tab_scroller {
                            hexpand: true;
                            vscrollbar-policy: never;
                            hscrollbar-policy: external;

                            child: Box tab_row {
                              spacing: 6;
                            };
                          }

                          Box {
                            spacing: 8;
                            valign: center;

                            Image {
                              icon-name: "view-sort-descending-symbolic";
                              accessible-role: presentation;
                            }

                            Label sort_label {}

                            styles [
                              "dimmed",
                            ]
                          }
                        }

                        Adw.WrapBox filter_row {
                          child-spacing: 6;
                          line-spacing: 6;
                          margin-top: 6;
                          margin-bottom: 6;
                          margin-start: 18;
                          margin-end: 18;

                          styles [
                            "filter-row",
                          ]

                          ToggleButton installed_filter {
                            label: _("Installed");
                          }

                          ToggleButton not_installed_filter {
                            label: _("Not Installed");
                          }

                          ToggleButton favourites_filter {
                            label: _("Favourites");
                          }

                          ToggleButton windows_filter {
                            label: _("Windows");
                          }

                          ToggleButton native_filter {
                            label: _("Native");
                          }

                          Button clear_filters {
                            label: _("Clear");
                            visible: false;

                            styles [
                              "flat",
                            ]
                          }
                        }

                        Box jump_back_in {
                          orientation: vertical;
                          spacing: 6;
                          visible: false;
                          margin-start: 18;
                          margin-end: 18;
                          margin-bottom: 6;

                          Label {
                            label: _("Jump Back In");
                            xalign: 0;

                            styles [
                              "heading",
                            ]
                          }

                          ScrolledWindow {
                            vscrollbar-policy: never;
                            propagate-natural-height: true;

                            child: Box jump_cards {
                              spacing: 12;
                              margin-bottom: 6;
                            };
                          }
                        }

                        Stack content_stack {
                          vexpand: true;

                          StackPage {
                            name: "grid";

                            child: ScrolledWindow {
                              hscrollbar-policy: never;

                              child: GridView grid {
                                single-click-activate: true;

                                styles [
                                  "library",
                                ]
                              };
                            };
                          }

                          StackPage {
                            name: "empty";

                            child: Adw.StatusPage empty_page {
                              title: _("No Games Yet");
                              description: _("Games from your launchers appear here once they are imported");

                              child: Button {
                                label: _("_Import Now");
                                use-underline: true;
                                halign: center;
                                action-name: "app.import";

                                styles [
                                  "pill",
                                  "suggested-action",
                                ]
                              };
                            };
                          }

                          StackPage {
                            name: "no-results";

                            child: Adw.StatusPage {
                              icon-name: "edit-find-symbolic";
                              title: _("No Results Found");
                              description: _("Try a different search or filter");
                            };
                          }

                          StackPage {
                            name: "history";

                            child: ScrolledWindow {
                              hscrollbar-policy: never;

                              child: Adw.Clamp {
                                margin-top: 12;
                                margin-bottom: 24;
                                margin-start: 12;
                                margin-end: 12;

                                child: Box history_groups {
                                  orientation: vertical;
                                  spacing: 24;
                                };
                              };
                            };
                          }

                          StackPage {
                            name: "no-hidden";

                            child: Adw.StatusPage {
                              icon-name: "view-reveal-symbolic";
                              title: _("No Hidden Games");
                              description: _("Games you hide show here, to unhide them");
                            };
                          }

                          StackPage {
                            name: "empty-collection";

                            child: Adw.StatusPage {
                              icon-name: "folder-symbolic";
                              title: _("Empty Collection");
                              description: _("Add games with “Add to Collection” in their menu");
                            };
                          }
                        }
                      };
                    };
                  }

                  // Fullscreen mode's first page, under the library.
                  $PinduHomePage home_page {}
                };
              };
            };
          };
        };

        // The options sheet: what to do with the focused game. View or X opens it, B
        // closes it.
        sheet: Adw.Clamp {
          maximum-size: 640;

          child: Box options_panel {
            orientation: vertical;
            spacing: 12;
            accessible-role: group;

            accessibility {
              labelled-by: options_title;
            }

            styles [
              "options-sheet",
            ]

            Label options_title {
              xalign: 0;
              ellipsize: end;

              styles [
                "title-2",
              ]
            }

            Stack options_stack {
              transition-type: crossfade;
              vhomogeneous: false;
              interpolate-size: true;

              StackPage {
                name: "main";

                child: ListBox options_list {
                  selection-mode: none;

                  styles [
                    "navigation-sidebar",
                  ]
                };
              }

              StackPage {
                name: "collections";

                child: ScrolledWindow {
                  hscrollbar-policy: never;
                  propagate-natural-height: true;
                  max-content-height: 360;

                  child: ListBox options_collections {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  };
                };
              }
            }
          };
        };
      };
    };

    // Fullscreen mode's search keyboard, which Y opens over the hint bar.
    [bottom]
    Revealer keyboard_revealer {
      transition-type: slide_up;

      child: Grid keyboard_grid {
        halign: center;
        row-spacing: 8;
        column-spacing: 8;
        column-homogeneous: true;
        row-homogeneous: true;

        styles [
          "search-keyboard",
        ]
      };
    }

    [bottom]
    Box hint_bar {
      halign: end;
      spacing: 24;

      styles [
        "hint-bar",
      ]
    }
  };
}

menu collection_menu {
  section {
    item {
      label: _("_Rename…");
      action: "win.rename-collection";
    }

    item {
      label: _("Move _Up");
      action: "win.move-collection-up";
    }

    item {
      label: _("Move _Down");
      action: "win.move-collection-down";
    }
  }

  section {
    item {
      label: _("_Delete");
      action: "win.delete-collection";
    }
  }
}

menu add_menu {
  section {
    item {
      label: _("_Add Game…");
      action: "app.add-game";
    }

    item {
      label: _("_Import Now");
      action: "app.import";
    }
  }
}

menu sort_menu {
  section {
    item {
      label: _("_Last Played");
      action: "win.sort-mode";
      target: "last-played";
    }

    item {
      label: _("Name _A–Z");
      action: "win.sort-mode";
      target: "name-ascending";
    }

    item {
      label: _("Name _Z–A");
      action: "win.sort-mode";
      target: "name-descending";
    }

    item {
      label: _("_Recently Added");
      action: "win.sort-mode";
      target: "recently-added";
    }

    item {
      label: _("_Playtime");
      action: "win.sort-mode";
      target: "playtime";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Show _Hidden Games");
