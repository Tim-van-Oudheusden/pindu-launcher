using Gtk 4.0;
using Adw 1;

template $PinduWindow: Adw.ApplicationWindow {
  title: _("Pindu launcher");
  width-request: 360;
  height-request: 294;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [start]
        MenuButton {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Add");
          menu-model: add_menu;
        }

        [start]
        Adw.Spinner sync_spinner {
          visible: false;
          tooltip-text: _("Importing Games…");
        }

        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }
      }

      content: Adw.StatusPage {
        icon-name: "io.github.tim_van_oudheusden.pindu-launcher";
        title: _("Pindu launcher");
      };
    };
  };
}

menu add_menu {
  section {
    item {
      label: _("_Import Now");
      action: "app.import";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_About Pindu launcher");
      action: "app.about";
    }
  }
}
