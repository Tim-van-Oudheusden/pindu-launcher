using Gtk 4.0;
using Adw 1;

template $PinduWindow: Adw.ApplicationWindow {
  title: _("Pindu launcher");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 730sp")

    setters {
      split_view.collapsed: true;
    }
  }

  // The hint bar shows what the controller's buttons do, in fullscreen mode.
  content: Adw.ToolbarView hint_toolbar {
    reveal-bottom-bars: false;

    content: Adw.ToastOverlay toast_overlay {
      // Fullscreen mode's panels: the options sheet at the bottom, the menu drawer on the
      // left and Quick Access on the right, over the pages.
      child: Adw.BottomSheet options_sheet {
        can-open: false;
        show-drag-handle: false;

        content: Adw.OverlaySplitView drawer {
          collapsed: true;
          show-sidebar: false;
          enable-show-gesture: false;
          max-sidebar-width: 440;
          sidebar-width-fraction: 0.4;

          // Fullscreen mode's menu drawer (`menu_drawer.blp`): Start or Guide opens it over
          // the page, B closes it.
          sidebar: $PinduMenuDrawer drawer_panel {};

          content: Adw.OverlaySplitView quick_access {
            collapsed: true;
            show-sidebar: false;
            sidebar-position: end;
            enable-show-gesture: false;
            max-sidebar-width: 440;
            sidebar-width-fraction: 0.4;

            // Fullscreen mode's Quick Access (`quick_access.blp`): R3 or the Deck's "…"
            // button opens it over the page, B closes it.
            sidebar: $PinduQuickAccess quick_access_panel {};

            content: Adw.OverlaySplitView split_view {
              sidebar: Adw.ToolbarView sidebar_toolbar {
                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle {
                    title: _("Pindu launcher");
                  };
                }

                content: Adw.Sidebar sidebar {
                  Adw.SidebarSection {
                    title: _("Library");

                    Adw.SidebarItem all_item {
                      title: _("All Games");
                      icon-name: "view-grid-symbolic";

                      suffix: Label all_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem installed_item {
                      title: _("Installed");
                      icon-name: "drive-harddisk-symbolic";

                      suffix: Label installed_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem favourites_item {
                      title: _("Favourites");
                      icon-name: "starred-symbolic";

                      suffix: Label favourites_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }

                    Adw.SidebarItem history_item {
                      title: _("Play History");
                      icon-name: "document-open-recent-symbolic";

                      suffix: Label history_count {
                        styles [
                          "dimmed",
                          "numeric",
                        ]
                      };
                    }
                  }

                  Adw.SidebarSection sources_section {
                    title: _("Sources");
                  }

                  Adw.SidebarSection collections_section {
                    title: _("Collections");
                    menu-model: collection_menu;
                  }

                  Adw.SidebarSection {
                    Adw.SidebarItem new_collection_item {
                      title: _("New Collection");
                      icon-name: "list-add-symbolic";
                    }
                  }
                };
              };

              // Fullscreen mode's top bar, which a design turns on: tabs for Home and the
              // library, and a clock. Home's backdrop runs on under it.
              content: Adw.ToolbarView top_bar_view {
                [top]
                Box top_bar {
                  visible: false;
                  spacing: 24;
                  margin-top: 18;
                  margin-start: 36;
                  margin-end: 36;

                  styles [
                    "fullscreen-top-bar",
                  ]

                  Box {
                    spacing: 6;
                    hexpand: true;

                    ToggleButton {
                      label: _("Home");
                      action-name: "win.show-page";
                      action-target: "'home'";

                      styles [
                        "page-tab",
                      ]
                    }

                    ToggleButton {
                      label: _("Library");
                      action-name: "win.show-page";
                      action-target: "'library'";

                      styles [
                        "page-tab",
                      ]
                    }
                  }

                  Label clock {
                    styles [
                      "clock",
                      "numeric",
                    ]
                  }
                }

                content: Adw.NavigationView navigation_view {
                  Adw.NavigationPage library_page {
                    title: _("All Games");
                    tag: "library";

                    child: Adw.ToolbarView {
                      [top]
                      Adw.HeaderBar {
                        [start]
                        ToggleButton sidebar_toggle {
                          icon-name: "sidebar-show-symbolic";
                          tooltip-text: _("Toggle Sidebar");
                          active: bind split_view.show-sidebar bidirectional;
                        }

                        [start]
                        MenuButton {
                          icon-name: "list-add-symbolic";
                          tooltip-text: _("Add");
                          menu-model: add_menu;
                        }

                        [start]
                        Adw.Spinner sync_spinner {
                          visible: false;
                          tooltip-text: _("Importing Games…");
                        }

                        title-widget: SearchEntry search_entry {
                          placeholder-text: _("Search games");
                          hexpand: true;
                          max-width-chars: 32;

                          accessibility {
                            label: _("Search games");
                          }
                        };

                        [end]
                        MenuButton {
                          primary: true;
                          icon-name: "open-menu-symbolic";
                          tooltip-text: _("Main Menu");
                          menu-model: primary_menu;
                        }

                        [end]
                        MenuButton {
                          icon-name: "view-sort-descending-symbolic";
                          tooltip-text: _("Sort");
                          menu-model: sort_menu;
                        }
                      }

                      content: Box {
                        orientation: vertical;

                        // Fullscreen mode's tabs, which the shoulder buttons switch, and the sort
                        // order, which the triggers cycle; the filter row hides meanwhile. Focus
                        // stays on the page below them.
                        Box library_tabs {
                          visible: false;
                          can-focus: false;
                          spacing: 24;
                          margin-top: 24;
                          margin-bottom: 12;
                          margin-start: 36;
                          margin-end: 36;

                          styles [
                            "library-tabs",
                          ]

                          ScrolledWindow tab_scroller {
                            hexpand: true;
                            vscrollbar-policy: never;
                            hscrollbar-policy: external;

                            child: Box tab_row {
                              spacing: 6;
                            };
                          }

                          // Shown while Quick Access's filters narrow the tabs.
                          Label filtered_chip {
                            label: _("Filtered");
                            valign: center;
                            visible: false;

                            styles [
                              "filtered-chip",
                            ]
                          }

                          Box {
                            spacing: 8;
                            valign: center;

                            Image {
                              icon-name: "view-sort-descending-symbolic";
                              accessible-role: presentation;
                            }

                            Label sort_label {}

                            styles [
                              "dimmed",
                            ]
                          }
                        }

                        Adw.WrapBox filter_row {
                          child-spacing: 6;
                          line-spacing: 6;
                          margin-top: 6;
                          margin-bottom: 6;
                          margin-start: 18;
                          margin-end: 18;

                          styles [
                            "filter-row",
                          ]

                          ToggleButton installed_filter {
                            label: _("Installed");
                          }

                          ToggleButton not_installed_filter {
                            label: _("Not Installed");
                          }

                          ToggleButton favourites_filter {
                            label: _("Favourites");
                          }

                          ToggleButton windows_filter {
                            label: _("Windows");
                          }

                          ToggleButton native_filter {
                            label: _("Native");
                          }

                          Button clear_filters {
                            label: _("Clear");
                            visible: false;

                            styles [
                              "flat",
                            ]
                          }
                        }

                        Box jump_back_in {
                          orientation: vertical;
                          spacing: 6;
                          visible: false;
                          margin-start: 18;
                          margin-end: 18;
                          margin-bottom: 6;

                          Label {
                            label: _("Jump Back In");
                            xalign: 0;

                            styles [
                              "heading",
                            ]
                          }

                          ScrolledWindow {
                            vscrollbar-policy: never;
                            propagate-natural-height: true;

                            child: Box jump_cards {
                              spacing: 12;
                              margin-bottom: 6;
                            };
                          }
                        }

                        Stack content_stack {
                          vexpand: true;

                          StackPage {
                            name: "grid";

                            child: ScrolledWindow {
                              hscrollbar-policy: never;

                              child: GridView grid {
                                single-click-activate: true;

                                styles [
                                  "library",
                                ]
                              };
                            };
                          }

                          StackPage {
                            name: "empty";

                            child: Adw.StatusPage empty_page {
                              title: _("No Games Yet");
                              description: _("Add a store and sign in to it, or import the games of the launchers you have");

                              child: Box {
                                orientation: vertical;
                                spacing: 12;
                                halign: center;

                                Button {
                                  label: _("Add a _Store");
                                  use-underline: true;
                                  action-name: "win.add-store";

                                  styles [
                                    "pill",
                                    "suggested-action",
                                  ]
                                }

                                Button {
                                  label: _("_Import Now");
                                  use-underline: true;
                                  action-name: "app.import";

                                  styles [
                                    "pill",
                                  ]
                                }
                              };
                            };
                          }

                          StackPage {
                            name: "no-results";

                            child: Adw.StatusPage {
                              icon-name: "edit-find-symbolic";
                              title: _("No Results Found");
                              description: _("Try a different search or filter");
                            };
                          }

                          StackPage {
                            name: "no-filter-matches";

                            child: Adw.StatusPage {
                              icon-name: "edit-find-symbolic";
                              title: _("No Games Match the Filters");
                              description: _("Clear the filters in Quick Access to see the whole tab");
                            };
                          }

                          StackPage {
                            name: "history";

                            child: ScrolledWindow {
                              hscrollbar-policy: never;

                              child: Adw.Clamp {
                                margin-top: 12;
                                margin-bottom: 24;
                                margin-start: 12;
                                margin-end: 12;

                                child: Box history_groups {
                                  orientation: vertical;
                                  spacing: 24;
                                };
                              };
                            };
                          }

                          StackPage {
                            name: "no-hidden";

                            child: Adw.StatusPage {
                              icon-name: "view-reveal-symbolic";
                              title: _("No Hidden Games");
                              description: _("Games you hide show here, to unhide them");
                            };
                          }

                          StackPage {
                            name: "empty-collection";

                            child: Adw.StatusPage {
                              icon-name: "folder-symbolic";
                              title: _("Empty Collection");
                              description: _("Add games with “Add to Collection” in their menu");
                            };
                          }
                        }
                      };
                    };
                  }

                  // Fullscreen mode's first page, under the library.
                  $PinduHomePage home_page {}
                };
              };
            };
          };
        };

        // The options sheet: what to do with the focused game. View or X opens it, B
        // closes it.
        sheet: Adw.Clamp {
          maximum-size: 640;

          child: Box options_panel {
            orientation: vertical;
            spacing: 12;
            accessible-role: group;

            accessibility {
              labelled-by: options_title;
            }

            styles [
              "options-sheet",
            ]

            Label options_title {
              xalign: 0;
              ellipsize: end;

              styles [
                "title-2",
              ]
            }

            Stack options_stack {
              transition-type: crossfade;
              vhomogeneous: false;
              interpolate-size: true;

              StackPage {
                name: "main";

                child: Box {
                  orientation: vertical;
                  spacing: 12;

                  ListBox options_list {
                    selection-mode: none;

                    styles [
                      "navigation-sidebar",
                    ]
                  }

                  // A game we run ourselves: the same switches as Quick Access's
                  // Performance.
                  ListBox options_performance {
                    selection-mode: none;
                    visible: false;

                    styles [
                      "boxed-list",
                    ]

                    Adw.SwitchRow options_overlay_row {
                      title: _("Performance Overlay");
                      subtitle: _("MangoHud");
                    }

                    Adw.SwitchRow options_gamemode_row {
                      title: _("GameMode");
                      subtitle: _("Asks the system to favour the game while it runs");
                    }
                  }
                };
              }

              StackPage {
                name: "collections";

                child: ScrolledWindow {
                  hscrollbar-policy: never;
                  propagate-natural-height: true;
                  max-content-height: 360;

                  child: ListBox options_collections {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  };
                };
              }
            }
          };
        };
      };
    };

    // Fullscreen mode's search keyboard, which Y opens over the hint bar.
    [bottom]
    Revealer keyboard_revealer {
      transition-type: slide_up;

      child: Grid keyboard_grid {
        halign: center;
        row-spacing: 8;
        column-spacing: 8;
        column-homogeneous: true;
        row-homogeneous: true;

        styles [
          "search-keyboard",
        ]
      };
    }

    [bottom]
    Box hint_bar {
      halign: end;
      spacing: 24;

      styles [
        "hint-bar",
      ]
    }
  };
}

menu collection_menu {
  section {
    item {
      label: _("_Rename…");
      action: "win.rename-collection";
    }

    item {
      label: _("Move _Up");
      action: "win.move-collection-up";
    }

    item {
      label: _("Move _Down");
      action: "win.move-collection-down";
    }
  }

  section {
    item {
      label: _("_Delete");
      action: "win.delete-collection";
    }
  }
}

menu add_menu {
  section {
    item {
      label: _("_Add Game…");
      action: "app.add-game";
    }

    item {
      label: _("_Import Now");
      action: "app.import";
    }
  }
}

menu sort_menu {
  section {
    item {
      label: _("_Last Played");
      action: "win.sort-mode";
      target: "last-played";
    }

    item {
      label: _("Name _A–Z");
      action: "win.sort-mode";
      target: "name-ascending";
    }

    item {
      label: _("Name _Z–A");
      action: "win.sort-mode";
      target: "name-descending";
    }

    item {
      label: _("_Recently Added");
      action: "win.sort-mode";
      target: "recently-added";
    }

    item {
      label: _("_Playtime");
      action: "win.sort-mode";
      target: "playtime";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Show _Hidden Games");
      action: "win.show-hidden";
    }

    item {
      label: _("_Fullscreen Mode");
      action: "win.fullscreen-mode";
    }
  }

  section {
    item {
      label: _("_Export Library…");
      action: "app.export-library";
    }

    item {
      label: _("I_mport Backup…");
      action: "app.import-backup";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Pindu launcher");
      action: "app.about";
    }
  }
}
