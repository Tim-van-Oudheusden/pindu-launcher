using Gtk 4.0;
using Adw 1;

// The menu drawer's power dock, at the bottom of its main level under the scrolling list:
// a line naming the focused button, over a row of round buttons, the ways out of the
// launcher at its start and the machine's at its end. Hidden while it has no buttons.
template $PinduPowerDock: Adw.Bin {
  visible: false;

  styles [
    "power-dock",
  ]

  child: Box {
    orientation: vertical;
    spacing: 12;

    // The focused button's name, and why it is dimmed when the system does not offer it;
    // empty while focus is elsewhere. Each button says the same to a screen reader.
    Label label {
      wrap: true;
      wrap-mode: word_char;
      justify: center;
      accessible-role: presentation;

      styles [
        "dock-label",
      ]
    }

    Box {
      spacing: 12;

      // Exit Fullscreen Mode, Switch to Desktop and Exit Pindu Launcher.
      Box leaving {
        spacing: 8;
        hexpand: true;
        halign: start;
      }

      // Suspend, Restart and Power Off.
      Box machine {
        spacing: 8;
        halign: end;
      }
    }
  };
}
