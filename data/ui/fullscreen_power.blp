using Gtk 4.0;
using Adw 1;

// The menu drawer's Power level, the "power" page of the window's drawer stack. Its entry
// row stays in the window's shared drawer list.
template $PinduPowerLevel: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Box {
      orientation: vertical;
      spacing: 12;

      Label {
        label: _("Power");
        xalign: 0;

        styles [
          "title-3",
        ]
      }

      // Suspend, Restart and Power Off, filled from what logind allows (the host's in the
      // Flatpak), then Switch to Desktop and Exit Pindu Launcher where they are offered.
      ListBox drawer_power {
        selection-mode: none;

        styles [
          "navigation-sidebar",
        ]
      }
    };
  };
}
