using Gtk 4.0;
using Adw 1;

// Fullscreen mode's menu drawer (`menu_drawer.rs`): the main level with the Playing Now
// cards and the places (Home, Library, Search and the first collections) over the power
// dock, every collection, and one collection's actions. The main window holds it on the
// left, where Start or Guide opens it over the page; over a running game in a `--steam`
// gamescope the overlay window holds it, where Guide opens it over the game. Its rows' and
// the dock's `win.*` actions are the host's.
template $PinduMenuDrawer: Box {
  orientation: vertical;
  accessible-role: group;

  accessibility {
    label: _("Menu");
  }

  styles [
    "menu-drawer",
  ]

  Stack stack {
    vexpand: true;
    transition-type: crossfade;

    StackPage {
      name: "main";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          // A card for each game that runs, with its session time, Return and, for a
          // game we started, Stop.
          Box playing_cards {
            orientation: vertical;
            spacing: 12;
            visible: false;
          }

          // Over a running game, its windows when it has more than one, to show another.
          Label windows_title {
            label: _("Windows");
            xalign: 0;
            visible: false;

            styles [
              "heading",
            ]
          }

          ListBox windows {
            selection-mode: none;
            visible: false;

            styles [
              "navigation-sidebar",
            ]
          }

          ListBox list {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]

            ListBoxRow {
              action-name: "win.drawer-home";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "go-home-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Home");
                  xalign: 0;
                }
              };
            }

            ListBoxRow library_row {
              action-name: "win.drawer-library";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "view-grid-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Library");
                  xalign: 0;
                  hexpand: true;
                  ellipsize: end;
                }

                // How many games the library holds, as Home's Library tile says.
                Label library_count {
                  styles [
                    "dim-label",
                    "numeric",
                  ]
                }
              };
            }

            // Starts a search with the on-screen keyboard, as Y does; ends with the glyph
            // of the button that does it on the controller in use. Left out over a
            // running game.
            ListBoxRow search_row {
              action-name: "win.drawer-search";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "system-search-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Search");
                  xalign: 0;
                  hexpand: true;
                  ellipsize: end;
                }

                Image search_glyph {
                  accessible-role: presentation;
                  visible: false;
                }
              };
            }

            // The first collections go here, under a Collections heading, each with its
            // icon, its name and its number of games (`menu_drawer.rs`).
            // Leads to every collection, when there are more than the entries list.
            ListBoxRow all_collections_row {
              action-name: "win.drawer-collections";
              visible: false;

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "view-more-horizontal-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("All Collections");
                  xalign: 0;
                  hexpand: true;
                  ellipsize: end;
                }

                Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;
                }
              };
            }
          }
        };
      };
    }

    StackPage {
      name: "collections";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Collections");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          ListBox collections {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]
          }
        };
      };
    }

    // One collection's actions, which View or X on a collection in the entries or in the
    // collections leads to: Rename…, Move Up, Move Down and Delete…, as the desktop
    // sidebar's collection menu has them.
    StackPage {
      name: "collection";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label collection_title {
            xalign: 0;
            wrap: true;

            styles [
              "title-3",
            ]
          }

          ListBox collection_actions {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]
          }
        };
      };
    }
  }

  // The main level's power dock (`fullscreen_power.blp`), under its scrolling list so it
  // stays in view however long the list is; shown with the main level only. The drawer
  // over a running game has none.
  Adw.Bin dock_holder {
    margin-top: 12;

    child: $PinduPowerDock dock {};
  }
}
