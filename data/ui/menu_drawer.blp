using Gtk 4.0;
using Adw 1;

// Fullscreen mode's menu drawer (`menu_drawer.rs`): the main level with the Playing Now
// cards and the entries, the collections, Controls (the button of each function, to bind
// it, `fullscreen_bindings.rs`), and Power. The main window holds it on the left, where
// Start or Guide opens it over the page; over a running game in a `--steam` gamescope the
// overlay window holds it, where Guide opens it over the game. Its rows' `win.*` actions
// are the host's.
template $PinduMenuDrawer: Box {
  orientation: vertical;
  accessible-role: group;

  accessibility {
    label: _("Menu");
  }

  styles [
    "menu-drawer",
  ]

  Stack stack {
    vexpand: true;
    transition-type: crossfade;

    StackPage {
      name: "main";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          // A card for each game that runs, with its session time, Return and, for a
          // game we started, Stop.
          Box playing_cards {
            orientation: vertical;
            spacing: 12;
            visible: false;
          }

          // Over a running game, its windows when it has more than one, to show another.
          Label windows_title {
            label: _("Windows");
            xalign: 0;
            visible: false;

            styles [
              "heading",
            ]
          }

          ListBox windows {
            selection-mode: none;
            visible: false;

            styles [
              "navigation-sidebar",
            ]
          }

          ListBox list {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]

            ListBoxRow {
              action-name: "win.drawer-home";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "go-home-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Home");
                  xalign: 0;
                }
              };
            }

            ListBoxRow {
              action-name: "win.drawer-library";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "view-grid-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Library");
                  xalign: 0;
                }
              };
            }

            ListBoxRow collections_row {
              action-name: "win.drawer-collections";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "folder-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Collections");
                  xalign: 0;
                  hexpand: true;
                }

                Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;
                }
              };
            }

            ListBoxRow controls_row {
              action-name: "win.drawer-controls";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "input-gaming-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Controls");
                  xalign: 0;
                  hexpand: true;
                }

                Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;
                }
              };
            }

            ListBoxRow exit_fullscreen_row {
              action-name: "win.leave-fullscreen";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "view-restore-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Exit Fullscreen Mode");
                  xalign: 0;
                }
              };
            }

            ListBoxRow quit_row {
              action-name: "app.quit";

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "application-exit-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Quit");
                  xalign: 0;
                }
              };
            }

            // Shown where logind lets the session suspend, restart or power off;
            // never in the Flatpak, which has no system bus.
            ListBoxRow power_row {
              action-name: "win.drawer-power";
              visible: false;

              child: Box {
                spacing: 16;

                Image {
                  icon-name: "system-shutdown-symbolic";
                  accessible-role: presentation;
                }

                Label {
                  label: _("Power");
                  xalign: 0;
                  hexpand: true;
                }

                Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;
                }
              };
            }
          }
        };
      };
    }

    StackPage {
      name: "collections";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Collections");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          ListBox collections {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]
          }
        };
      };
    }

    // Each function with its button; choosing one waits for the next button press.
    StackPage {
      name: "controls";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Controls");
            xalign: 0;

            styles [
              "title-3",
            ]
          }

          ListBox bindings {
            selection-mode: none;

            styles [
              "navigation-sidebar",
            ]
          }
        };
      };
    }

    StackPage {
      name: "power";

      child: $PinduPowerLevel power_level {};
    }
  }
}
