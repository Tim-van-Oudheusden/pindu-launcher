using Gtk 4.0;
using Adw 1;

template $PinduPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage general_page {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Library");

      Adw.ComboRow tile_size_row {
        title: _("Cover Size");

        model: StringList {
          strings [
            _("Small"),
            _("Medium"),
            _("Large"),
          ]
        };
      }

      Adw.SwitchRow titles_row {
        title: _("Show Titles");
        subtitle: _("The game's name below its cover");
      }

      Adw.SwitchRow badges_row {
        title: _("Show Badges");
        subtitle: _("The launcher and state badges on covers");
      }
    }

    Adw.PreferencesGroup {
      title: _("Launching");

      Adw.SwitchRow exit_row {
        title: _("Exit After Launching");
        subtitle: _("Quit once a store game is handed to its launcher. Games Pindu launcher starts itself keep it running, to record their playtime.");
      }
    }

    Adw.PreferencesGroup {
      title: _("Controller");

      Adw.SwitchRow controller_row {
        title: _("Navigate With a Controller");
        subtitle: _("Move with the D-pad or left stick, open with A and go back with B. While this is on, a Steam Deck's own controls work only as a controller.");
      }

      // Brand names are fine here, unlike in fullscreen mode: this is the settings page.
      Adw.ComboRow prompts_row {
        title: _("Button Prompts");
        subtitle: _("The glyphs fullscreen mode shows for the buttons. Under Steam Input every controller looks like Steam's own, which Automatic shows with letters.");

        model: StringList {
          strings [
            _("Automatic"),
            _("Letters (Xbox)"),
            _("Shapes (PlayStation)"),
            _("Letters (Nintendo)"),
          ]
        };
      }

      Adw.ComboRow swap_row {
        title: _("Swap Confirm and Back");
        subtitle: _("On, the right button opens and the bottom one goes back. Automatic swaps them for Nintendo letters.");

        model: StringList {
          strings [
            _("Automatic"),
            _("Off"),
            _("On"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Permissions");
      description: _("Store games start through their launcher and always work. Desktop entries, Flatpak games and games added by hand start on this computer, outside the sandbox, which needs your permission.");

      Adw.ActionRow host_row {
        title: _("Start Games on This Computer");

        [suffix]
        Label host_status {
          styles [
            "dim-label",
          ]
        }
      }

      Adw.ActionRow command_row {
        title: _("Run This Command, Then Restart Pindu launcher");
        subtitle-selectable: true;

        styles [
          "property",
          "command",
        ]

        [suffix]
        Button {
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy Command");
          valign: center;
          clicked => $copy_command() swapped;

          styles [
            "flat",
          ]
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Sources");
    icon-name: "folder-symbolic";

    Adw.PreferencesGroup sources_group {
      title: _("Sources");
      description: _("Where games come from. A source that is off is no longer imported; one left out of the sidebar still is.");
    }
  }

  Adw.PreferencesPage artwork_page {
    title: _("Artwork");
    icon-name: "image-x-generic-symbolic";

    Adw.PreferencesGroup {
      title: _("SteamGridDB");
      description: _("Art from SteamGridDB needs your own API key, which is kept in your keyring. Missing art is fetched right after you save a key and after each import.");

      Adw.PasswordEntryRow key_row {
        title: _("API Key");
        show-apply-button: true;
        apply => $save_key() swapped;
      }

      Adw.ActionRow key_status_row {
        title: _("Stored Key");
      }

      Adw.SwitchRow prefer_row {
        title: _("Prefer SteamGridDB Art");
        subtitle: _("Show it before the launcher's own art; art you pick always comes first");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Windows");
    icon-name: "applications-games-symbolic";

    Adw.PreferencesGroup {
      title: _("Defaults");
      description: _("Windows games run with these unless their page says otherwise.");

      Adw.ComboRow default_proton_row {
        title: _("Proton");

        model: StringList {};
      }

      Adw.ActionRow prefix_folder_row {
        title: _("Prefix Folder");
        subtitle-selectable: true;

        [suffix]
        Button reset_prefix_folder_button {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use the Games Folder");
          valign: center;
          clicked => $reset_prefix_folder() swapped;

          styles [
            "flat",
          ]
        }

        [suffix]
        Button {
          label: _("_Choose…");
          use-underline: true;
          valign: center;
          clicked => $choose_prefix_folder() swapped;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Tools");
      description: _("Games added from now on start with these switched on; each game's page can change them.");

      Adw.SwitchRow default_mangohud_row {
        title: _("MangoHud");
        subtitle: _("An overlay with the frame rate and how busy the computer is");
      }

      Adw.SwitchRow default_gamemode_row {
        title: _("GameMode");
        subtitle: _("Asks the system to favour the game while it runs");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Proton");
    icon-name: "folder-download-symbolic";

    Adw.PreferencesGroup downloaded_group {
      title: _("Downloaded Builds");
      description: _("Builds installed here can be chosen for any Windows game, like those from Steam.");
    }

    Adw.PreferencesGroup releases_group {
      title: _("Releases");
      description: _("GE-Proton and Proton-CachyOS builds published on GitHub. Pindu launcher only goes online when you check for releases or install one; games never download Proton when they start.");

      header-suffix: Button check_releases_button {
        label: _("_Check for Releases");
        use-underline: true;
        valign: center;
        clicked => $check_releases() swapped;
      };

      Adw.ActionRow releases_status_row {
        title: _("Not Checked Yet");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Fullscreen");
    icon-name: "view-fullscreen-symbolic";

    Adw.PreferencesGroup {
      title: _("Fullscreen Mode");
      description: _("The library at the size of a TV, driven by a controller. Enter it from the main menu, with F11 or with the controller's Guide button; leave it with F11 or Esc.");

      Adw.SwitchRow start_fullscreen_row {
        title: _("Start in Fullscreen Mode");
      }

      Adw.SwitchRow sounds_row {
        title: _("Navigation Sounds");
        subtitle: _("A soft sound when the controller moves, selects or goes back");
      }

      Adw.ActionRow volume_row {
        title: _("Volume");
        activatable: false;
        focusable: false;

        [suffix]
        Scale volume_scale {
          hexpand: true;
          digits: 0;
          draw-value: false;

          adjustment: Adjustment {
            lower: 0;
            upper: 100;
            step-increment: 5;
            page-increment: 20;
          };

          accessibility {
            label: _("Navigation Sound Volume");
          }
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Accessibility");

      Adw.SwitchRow reduce_motion_row {
        title: _("Reduce Motion");
        subtitle: _("Home's background holds still and art changes without a fade, as when animations are off in the system settings");
      }

      Adw.SwitchRow large_text_row {
        title: _("Larger Text");
        subtitle: _("Text about a quarter larger, to read from across the room");
      }
    }
  }
}
