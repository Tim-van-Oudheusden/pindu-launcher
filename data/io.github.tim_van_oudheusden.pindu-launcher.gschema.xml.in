<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pindu-launcher">
  <schema id="@APP_ID@" path="@SCHEMA_PATH@">
    <key name="window-width" type="i">
      <default>1024</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="tile-size" type="s">
      <choices>
        <choice value="small"/>
        <choice value="medium"/>
        <choice value="large"/>
      </choices>
      <default>'medium'</default>
      <summary>Cover tile size</summary>
      <description>Small is 150×225, medium 200×300 and large 250×375 pixels.</description>
    </key>
    <key name="library-layout" type="s">
      <choices>
        <choice value="grid"/>
        <choice value="list"/>
      </choices>
      <default>'grid'</default>
      <summary>Library layout</summary>
      <description>Whether the desktop library shows its games as covers in a grid or as rows in a list with their source, install state, last played date and playtime. Fullscreen mode always shows the grid.</description>
    </key>
    <key name="exit-after-launch" type="b">
      <default>false</default>
      <summary>Exit after launching a store game</summary>
      <description>Quit once a store game is handed to its launcher. Games Pindu launcher starts itself keep it running, as it records their play sessions.</description>
    </key>
    <key name="show-badges" type="b">
      <default>true</default>
      <summary>Show badges on covers</summary>
      <description>The launcher badge top left and the state badge top right.</description>
    </key>
    <key name="hidden-sources" type="as">
      <default>[]</default>
      <summary>Sources left out of the sidebar</summary>
      <description>Source IDs whose sidebar rows are hidden; their games still import.</description>
    </key>
    <key name="source-order" type="as">
      <default>[]</default>
      <summary>Source order for a game's copies</summary>
      <description>Source IDs, first preferred: which copy Play starts for a game with copies from several sources when you chose none. Sources left out follow in the default order.</description>
    </key>
    <key name="prefer-steamgriddb" type="b">
      <default>false</default>
      <summary>Prefer SteamGridDB art</summary>
      <description>Show SteamGridDB art before the launcher's own; art you pick always comes first.</description>
    </key>
    <key name="wikidata-metadata" type="b">
      <default>false</default>
      <summary>Get metadata from Wikidata</summary>
      <description>Let Refresh Metadata look games up on Wikidata by their Steam app ID for their developer and genres. Nothing is fetched until you ask, and never during an import.</description>
    </key>
    <key name="show-titles" type="b">
      <default>true</default>
      <summary>Show titles below covers</summary>
    </key>
    <key name="controller-navigation" type="b">
      <default>false</default>
      <summary>Navigate the window with a controller</summary>
      <description>Move focus with the D-pad or left stick, open with A and go back with B. Controllers are only opened while this is on.</description>
    </key>
    <key name="controller-prompts" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="letters"/>
        <choice value="shapes"/>
        <choice value="nintendo-letters"/>
      </choices>
      <default>'auto'</default>
      <summary>Button prompts</summary>
      <description>The glyphs fullscreen mode shows for the controller's buttons. Auto follows the controller: letters with A at the bottom, shapes, or letters with A on the right. Steam Input shows every controller as its own virtual pad, which Auto takes for letters.</description>
    </key>
    <key name="swap-confirm-back" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="off"/>
        <choice value="on"/>
      </choices>
      <default>'auto'</default>
      <summary>Swap confirm and back</summary>
      <description>Whether the right face button confirms and the bottom one goes back, rather than the other way round. Auto swaps them when the button prompts put A on the right.</description>
    </key>
    <key name="controller-bindings" type="a{ss}">
      <default>{}</default>
      <summary>Controller button bindings</summary>
      <description>The fullscreen functions given to other controller buttons from the menu's Controls: each changed button, such as north or left-shoulder, with its function, such as search. Buttons not listed keep their default function. Guide, the D-pad and the left stick never change.</description>
    </key>
    <key name="navigation-repeat-delay" type="s">
      <choices>
        <choice value="short"/>
        <choice value="normal"/>
        <choice value="long"/>
      </choices>
      <default>'normal'</default>
      <summary>Navigation repeat delay</summary>
      <description>How long a controller direction is held in fullscreen mode before focus starts moving again on its own: short is 0.2 seconds, normal 0.3 and long 0.6. It changes only the launcher's own navigation, never what a game receives.</description>
    </key>
    <key name="navigation-repeat-rate" type="s">
      <choices>
        <choice value="slow"/>
        <choice value="normal"/>
        <choice value="fast"/>
      </choices>
      <default>'normal'</default>
      <summary>Navigation repeat rate</summary>
      <description>How fast focus keeps moving while a controller direction is held in fullscreen mode: slow is every 100 ms, normal every 50 ms and fast every 30 ms. It changes only the launcher's own navigation, never what a game receives.</description>
    </key>
    <key name="navigation-dead-zone" type="s">
      <choices>
        <choice value="small"/>
        <choice value="normal"/>
        <choice value="large"/>
      </choices>
      <default>'normal'</default>
      <summary>Stick dead zone for navigation</summary>
      <description>How far the left stick moves before it moves focus in fullscreen mode: small is past 30 % of its travel, normal past half and large past 70 %. It changes only the launcher's own navigation, never what a game receives.</description>
    </key>
    <key name="default-proton" type="s">
      <default>''</default>
      <summary>Default Proton build</summary>
      <description>The internal name of the Proton build Windows games run with unless they name their own. Empty for the newest build on this computer.</description>
    </key>
    <key name="prefix-folder" type="s">
      <default>''</default>
      <summary>Prefix folder</summary>
      <description>The folder new Windows games get their own prefix in. Empty for ~/Games/pindu-launcher/prefixes.</description>
    </key>
    <key name="save-copy-folder" type="s">
      <default>''</default>
      <summary>Folder for copies of save snapshots</summary>
      <description>The folder, picked through the file chooser, that every new save snapshot is also copied to, as the sandbox reaches it. Empty to keep snapshots only in ~/Games/pindu-launcher/save-snapshots.</description>
    </key>
    <key name="default-mangohud" type="b">
      <default>false</default>
      <summary>MangoHud for new Windows games</summary>
      <description>Whether Windows games added from now on start with the MangoHud performance overlay.</description>
    </key>
    <key name="default-gamemode" type="b">
      <default>false</default>
      <summary>GameMode for new Windows games</summary>
      <description>Whether Windows games added from now on start with GameMode.</description>
    </key>
    <key name="start-in-fullscreen" type="b">
      <default>false</default>
      <summary>Start in fullscreen mode</summary>
      <description>Open the window in fullscreen mode, the controller-driven presentation of the library.</description>
    </key>
    <key name="navigation-sounds" type="b">
      <default>false</default>
      <summary>Navigation sounds</summary>
      <description>Play a soft sound in fullscreen mode when the controller moves focus, selects or goes back.</description>
    </key>
    <key name="navigation-sound-volume" type="i">
      <range min="0" max="100"/>
      <default>60</default>
      <summary>Navigation sound volume</summary>
      <description>How loud the navigation sounds play, from 0 (silent) to 100 (full).</description>
    </key>
    <key name="fullscreen-reduce-motion" type="b">
      <default>false</default>
      <summary>Reduce motion in fullscreen mode</summary>
      <description>Hold Home's animated background on its first frame and change art without a crossfade in fullscreen mode. Turning off animations in the system settings does the same.</description>
    </key>
    <key name="fullscreen-text-size" type="s">
      <choices>
        <choice value="default"/>
        <choice value="large"/>
        <choice value="larger"/>
        <choice value="largest"/>
      </choices>
      <default>'default'</default>
      <summary>Text size in fullscreen mode</summary>
      <description>How large fullscreen mode's text is, for reading from across the room: each step past default adds about a quarter. The desktop window is not affected.</description>
    </key>
    <key name="fullscreen-large-text" type="b">
      <default>false</default>
      <summary>Larger text in fullscreen mode (replaced)</summary>
      <description>Replaced by fullscreen-text-size. On start-up, when this is on and no text size is chosen yet, the text size becomes large, the size this gave, and this turns off.</description>
    </key>
    <key name="fullscreen-hold-to-confirm" type="b">
      <default>false</default>
      <summary>Hold to confirm in fullscreen mode</summary>
      <description>Make Power Off, Restart, Forget and Stop need the controller's confirm button held down for a second in fullscreen mode, with the hold's progress shown. The keyboard and the pointer act at once.</description>
    </key>
    <key name="fullscreen-custom-style" type="b">
      <default>false</default>
      <summary>Custom fullscreen style</summary>
      <description>Restyle fullscreen mode with your own stylesheet, fullscreen.css in the app's config folder. The desktop window is not affected.</description>
    </key>
    <key name="fullscreen-design" type="s">
      <default>'ribbon'</default>
      <summary>Fullscreen design</summary>
      <description>The id of the design fullscreen mode is shown in: a theme folder shipped with the app or in the app's config folder under themes. Empty for Adwaita, the standard look. The desktop window is not affected.</description>
    </key>
    <key name="fullscreen-design-variant" type="s">
      <default>''</default>
      <summary>Fullscreen design variant</summary>
      <description>The id of the chosen variant of the fullscreen design, for a design that offers variants; its stylesheet applies after the design's own. An empty or unknown id picks the design's first variant.</description>
    </key>
    <key name="fullscreen-background-blur" type="s">
      <choices>
        <choice value="off"/>
        <choice value="low"/>
        <choice value="high"/>
      </choices>
      <default>'off'</default>
      <summary>Fullscreen background blur</summary>
      <description>How much Home's background and the focused game's art behind it are blurred in fullscreen mode. A design can restyle each strength.</description>
    </key>
    <key name="fullscreen-background-dim" type="s">
      <choices>
        <choice value="off"/>
        <choice value="low"/>
        <choice value="high"/>
      </choices>
      <default>'off'</default>
      <summary>Fullscreen background dim</summary>
      <description>How much Home's background and the focused game's art behind it are darkened in fullscreen mode. A design can restyle each strength.</description>
    </key>
    <key name="steamgriddb-prompt-shown" type="b">
      <default>false</default>
      <summary>SteamGridDB prompt shown</summary>
      <description>Whether the window has offered, once, to set up a SteamGridDB API key for game art.</description>
    </key>
    <key name="first-sync-summary-shown" type="b">
      <default>false</default>
      <summary>First sync summary shown</summary>
      <description>Whether the summary of what the library's first sync found has been dismissed, after which it never shows again.</description>
    </key>
    <key name="last-backup" type="x">
      <default>0</default>
      <summary>Last library backup</summary>
      <description>When the library was last exported, in seconds since the Unix epoch; 0 means never. Library Health shows it.</description>
    </key>
  </schema>
</schemalist>
