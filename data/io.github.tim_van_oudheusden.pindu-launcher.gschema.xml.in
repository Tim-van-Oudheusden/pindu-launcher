<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pindu-launcher">
  <schema id="@APP_ID@" path="@SCHEMA_PATH@">
    <key name="window-width" type="i">
      <default>1024</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="tile-size" type="s">
      <choices>
        <choice value="small"/>
        <choice value="medium"/>
        <choice value="large"/>
      </choices>
      <default>'medium'</default>
      <summary>Cover tile size</summary>
      <description>Small is 150×225, medium 200×300 and large 250×375 pixels.</description>
    </key>
    <key name="exit-after-launch" type="b">
      <default>false</default>
      <summary>Exit after launching a store game</summary>
      <description>Quit once a store game is handed to its launcher. Games Pindu launcher starts itself keep it running, as it records their play sessions.</description>
    </key>
    <key name="show-badges" type="b">
      <default>true</default>
      <summary>Show badges on covers</summary>
      <description>The launcher badge top left and the state badge top right.</description>
    </key>
    <key name="hidden-sources" type="as">
      <default>[]</default>
      <summary>Sources left out of the sidebar</summary>
      <description>Source IDs whose sidebar rows are hidden; their games still import.</description>
    </key>
    <key name="prefer-steamgriddb" type="b">
      <default>false</default>
      <summary>Prefer SteamGridDB art</summary>
      <description>Show SteamGridDB art before the launcher's own; art you pick always comes first.</description>
    </key>
    <key name="show-titles" type="b">
      <default>true</default>
      <summary>Show titles below covers</summary>
    </key>
    <key name="controller-navigation" type="b">
      <default>false</default>
      <summary>Navigate the window with a controller</summary>
      <description>Move focus with the D-pad or left stick, open with A and go back with B. Controllers are only opened while this is on.</description>
    </key>
    <key name="default-proton" type="s">
      <default>''</default>
      <summary>Default Proton build</summary>
      <description>The internal name of the Proton build Windows games run with unless they name their own. Empty for the newest build on this computer.</description>
    </key>
    <key name="prefix-folder" type="s">
      <default>''</default>
      <summary>Prefix folder</summary>
      <description>The folder new Windows games get their own prefix in. Empty for ~/Games/pindu-launcher/prefixes.</description>
    </key>
    <key name="default-mangohud" type="b">
      <default>false</default>
      <summary>MangoHud for new Windows games</summary>
      <description>Whether Windows games added from now on start with the MangoHud performance overlay.</description>
    </key>
    <key name="default-gamemode" type="b">
      <default>false</default>
      <summary>GameMode for new Windows games</summary>
      <description>Whether Windows games added from now on start with GameMode.</description>
    </key>
    <key name="start-in-fullscreen" type="b">
      <default>false</default>
      <summary>Start in fullscreen mode</summary>
      <description>Open the window in fullscreen mode, the controller-driven presentation of the library.</description>
    </key>
    <key name="navigation-sounds" type="b">
      <default>false</default>
      <summary>Navigation sounds</summary>
      <description>Play a soft sound in fullscreen mode when the controller moves focus, selects or goes back.</description>
    </key>
    <key name="fullscreen-custom-style" type="b">
      <default>false</default>
      <summary>Custom fullscreen style</summary>
      <description>Restyle fullscreen mode with your own stylesheet, fullscreen.css in the app's config folder. The desktop window is not affected.</description>
    </key>
    <key name="fullscreen-design" type="s">
      <default>''</default>
      <summary>Fullscreen design</summary>
      <description>The id of the design fullscreen mode is shown in: a theme folder shipped with the app or in the app's config folder under themes. Empty for the standard look. The desktop window is not affected.</description>
    </key>
    <key name="steamgriddb-prompt-shown" type="b">
      <default>false</default>
      <summary>SteamGridDB prompt shown</summary>
      <description>Whether the window has offered, once, to set up a SteamGridDB API key for game art.</description>
    </key>
  </schema>
</schemalist>
