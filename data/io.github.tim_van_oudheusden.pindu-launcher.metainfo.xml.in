<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Pindu launcher</name>
  <summary>Play all your games</summary>
  <description>
    <p>
      Pindu launcher gathers every game on your computer into one library, whichever launcher
      installed it. Browse your covers, pick up where you left off and start any game with one
      click.
    </p>
    <p>Games come from:</p>
    <ul>
      <li>Steam, native or Flatpak</li>
      <li>Heroic: Epic Games, GOG, Amazon and sideloaded games</li>
      <li>Lutris, Bottles, Faugus and itch</li>
      <li>Games installed as apps, including Flatpaks</li>
      <li>Games you add yourself</li>
    </ul>
    <p>Keep your library tidy:</p>
    <ul>
      <li>Search, sort and filter by installed, favourite, Windows or native</li>
      <li>Group games into your own collections</li>
      <li>Jump back into recent and pinned games</li>
      <li>See when you played and for how long, including playtime from your launchers</li>
      <li>Hide games you never play</li>
      <li>Choose your own artwork, or find it on SteamGridDB with your own key</li>
    </ul>
    <p>
      Store games start through their own launcher, which keeps their settings, updates and
      playtime. Your library works offline, and nothing leaves your computer unless you ask
      for artwork.
    </p>
  </description>

  <developer id="io.github.tim_van_oudheusden">
    <name translate="no">Tim van Oudheusden</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">pindu-launcher</translation>

  <url type="homepage">https://github.com/Tim-van-Oudheusden/pindu-launcher</url>
  <url type="bugtracker">https://github.com/Tim-van-Oudheusden/pindu-launcher/issues</url>
  <url type="vcs-browser">https://github.com/Tim-van-Oudheusden/pindu-launcher</url>

  <branding>
    <color type="primary" scheme_preference="light">#9bd8fb</color>
    <color type="primary" scheme_preference="dark">#174c8c</color>
  </branding>
  
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/1-library.png</image>
      <caption>All your games in one library</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/2-game-page.png</image>
      <caption>Details and launch options for each game</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/3-play-history.png</image>
      <caption>See what you played and for how long</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/4-collection.png</image>
      <caption>Group games into your own collections</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/5-game-page-dark.png</image>
      <caption>Light and dark style</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </supports>

  <releases>
    <release version="0.5.1" date="2026-11-19">
      <description>
        <p>Change a game's artwork from SteamGridDB or your own files, and a tidier library.</p>
        <ul>
          <li>Change Artwork, in a game's menu and in fullscreen mode's game options, finds covers, banners, logos, icons and square art on SteamGridDB, page by page, or uses an image file; a picked image shows at once, and Use Original brings the launcher's back</li>
          <li>When SteamGridDB finds the wrong game for a title, Different Game… lets you choose the right one, which is remembered</li>
          <li>Fullscreen mode switches between kinds of art with the shoulder buttons and loads more images as you reach the end</li>
          <li>Jump Back In cards are evenly rounded, their art fills them without blurred bands, and Play shows on hover and keyboard focus</li>
          <li>Fullscreen mode's library spaces covers evenly in rows and columns, so the focused cover is never hidden behind its neighbours</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-18">
      <description>
        <p>Fullscreen mode in gamescope sessions, where the launcher takes Steam's place.</p>
        <ul>
          <li>Play shows a starting screen with the game's art until the game is in front, and offers Cancel after five seconds, so a launch that hangs never leaves you stuck</li>
          <li>In a gamescope session Steam's own launch window stays hidden; Steam shows only when it needs an answer, such as a sign-in or a cloud conflict</li>
          <li>The launcher notices within about two seconds that a game handed to Steam, Heroic or Lutris has ended</li>
          <li>Home opens Steam Big Picture where Steam is installed; the launcher leaves the screen and the controller to Steam until you leave Big Picture</li>
          <li>The menu's Power lists Suspend, Restart, Power Off and Exit, also in the Flatpak with access outside the sandbox; Exit is left out when the launcher is the session itself</li>
          <li>The menu's Controls lets you choose which button does what, and Reset to Defaults brings the usual buttons back</li>
          <li>In a gamescope session started with --steam, the games the launcher starts come to the front, the launcher comes back when they end, and Return in Playing Now goes back to the game</li>
          <li>Guide opens the menu over a running game, as in Steam: Return, Stop, Home and Library, and the game's windows to switch between when it has more than one</li>
          <li>Guide + A, the ⋯ button or a right stick click opens Quick Access, over a running game too, including Network and Bluetooth; Guide on its own acts when you let go of it</li>
          <li>Games handed to Steam, Heroic or Lutris come to the front too and show as playing, with Return instead of Play and a Stop that closes their windows, and Steam's own window shows while it needs an answer</li>
          <li>Steam starts without its library window in a gamescope session, when the launcher may run commands on the host</li>
          <li>"Opening Steam…" no longer stays on screen when the store launcher never answers</li>
          <li>The Performance Overlay switch drives MangoApp in a gamescope session</li>
          <li>The RPM and DEB packages add a "Pindu launcher" session to gamescope-session-plus login screens, with Switch to Desktop in the Power menu</li>
          <li>Games started outside the Flatpak open on the launcher's own display</li>
          <li>Fullscreen mode can install Steam, Heroic or Lutris from Add a Store</li>
          <li>Wi-Fi passphrases and Bluetooth PINs are typed with the on-screen keyboard</li>
          <li>Once the launcher starts a game, the controller is the game's: only Guide and Guide + A reach the launcher until Guide, switching back to it or the game ending, so buttons no longer act in the game and the launcher at once</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-11-17">
      <description>
        <p>A fix for fullscreen mode in virtual machines.</p>
        <ul>
          <li>Fullscreen mode no longer crashes in a virtual machine with 3D acceleration and Venus (virtio-gpu)</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-11-16">
      <description>
        <p>Release files for ARM (aarch64), a fix for a crash on Steam libraries, and more in the fullscreen Quick Access panel.</p>
        <ul>
          <li>Flatpak, RPM and DEB release files are now built for aarch64 (ARM) as well as x86_64</li>
          <li>Fixed a crash when importing a Steam library with deeply nested data</li>
          <li>Windows games use a Proton build made for your machine's architecture</li>
          <li>Turning on MangoHud now explains when it cannot work inside the sandbox</li>
          <li>Quick Access in fullscreen mode gains Network, Bluetooth, System Update, Sound Output and Power sections</li>
          <li>The on-screen keyboard has capitals and symbols, and a dialog for entering passphrases</li>
          <li>The RPM and DEB packages now depend on GStreamer's good plug-ins</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-11-07">
      <description>
        <p>Native packages, your own fullscreen style in Preferences, and the start of translations.</p>
        <ul>
          <li>Install Pindu launcher as an RPM on Fedora 45 or a DEB on Debian testing and Ubuntu 26.10, next to the Flatpak</li>
          <li>Turn your own fullscreen stylesheet on, import it, open its folder or reset it in Preferences, which also lists its problems</li>
          <li>Without umu-launcher, Windows games now say what is missing and how to install it</li>
          <li>The focused cover in the first row of the fullscreen library is no longer cut off</li>
          <li>A first, partial Dutch translation; help translate on Weblate</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-07">
      <description>
        <p>Windows games, and a fullscreen mode for playing from the couch with a controller.</p>
        <ul>
          <li>Add a Windows game from its .exe or installer and play it with Proton, with launch settings and logs for each game</li>
          <li>Download GE-Proton and Proton-CachyOS builds from Preferences</li>
          <li>Run native games in the Steam Linux Runtime, and turn on MangoHud or GameMode for a game</li>
          <li>A fullscreen mode with Home, Library and game pages, an on-screen keyboard for search and a Quick Access panel</li>
          <li>Fullscreen designs, Ribbon and Panorama, with variants, and your own stylesheet</li>
          <li>Reduce Motion, Larger Text and a volume for navigation sounds in fullscreen mode</li>
          <li>Control the desktop window and its menus with a controller</li>
          <li>SteamGridDB art arrives as soon as you save your key</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-04">
      <description>
        <p>The first release.</p>
        <ul>
          <li>One library for Steam, Heroic, Lutris, Bottles, Faugus, installed apps and games you add yourself</li>
          <li>Collections, favourites, Jump Back In and play history</li>
          <li>Artwork from your launchers, your own files or SteamGridDB</li>
          <li>Search from GNOME Shell</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
