<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Pindu launcher</name>
  <summary>Play all your games</summary>
  <description>
    <p>
      Pindu launcher gathers every game on your computer into one library, whichever launcher
      installed it. Browse your covers, pick up where you left off and start any game with one
      click.
    </p>
    <p>Games come from:</p>
    <ul>
      <li>Steam, native or Flatpak</li>
      <li>Heroic: Epic Games, GOG, Amazon and sideloaded games</li>
      <li>Lutris, Bottles, Faugus, Legendary and itch</li>
      <li>Games installed as apps, including Flatpaks</li>
      <li>Games you add yourself</li>
    </ul>
    <p>Keep your library tidy:</p>
    <ul>
      <li>Search, sort and filter by installed, favourite, Windows or native</li>
      <li>Group games into your own collections</li>
      <li>Jump back into recent and pinned games</li>
      <li>See when you played and for how long, including playtime from your launchers</li>
      <li>Hide games you never play</li>
      <li>Choose your own artwork, or find it on SteamGridDB with your own key</li>
    </ul>
    <p>
      Store games start through their own launcher, which keeps their settings, updates and
      playtime. Your library works offline, and nothing leaves your computer unless you ask
      for artwork.
    </p>
  </description>

  <developer id="io.github.tim_van_oudheusden">
    <name translate="no">Tim van Oudheusden</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">pindu-launcher</translation>

  <url type="homepage">https://github.com/Tim-van-Oudheusden/pindu-launcher</url>
  <url type="bugtracker">https://github.com/Tim-van-Oudheusden/pindu-launcher/issues</url>
  <url type="vcs-browser">https://github.com/Tim-van-Oudheusden/pindu-launcher</url>

  <branding>
    <color type="primary" scheme_preference="light">#9bd8fb</color>
    <color type="primary" scheme_preference="dark">#174c8c</color>
  </branding>
  
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/1-library.png</image>
      <caption>All your games in one library</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/2-game-page.png</image>
      <caption>Details and launch options for each game</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/3-play-history.png</image>
      <caption>See what you played and for how long</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/4-collection.png</image>
      <caption>Group games into your own collections</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Tim-van-Oudheusden/pindu-launcher/v0.1.0/data/screenshots/5-game-page-dark.png</image>
      <caption>Light and dark style</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </supports>

  <releases>
    <release version="0.7.0~rc4" type="development" date="2026-11-24">
      <description>
        <p>Quick Access is split into six sections, the menu drawer has a power dock, fullscreen Home shows your games by category, a new console is led through its first set-up, and Steam's Big Picture and first start fit into fullscreen mode.</p>
        <ul>
          <li>Quick Access has six sections that LB and RB switch between: Quick, Notifications, Design, Controller, System and Manage. Each setting now sits in the section it belongs to</li>
          <li>Quick Access's Quick section has tiles for Sound Output, Bluetooth, Network, Surprise Me, Refresh Library and Add a Game, plus a card for what the page underneath offers</li>
          <li>Left and Right change a setting in Quick Access without opening it, and Design shows each fullscreen design as a preview card</li>
          <li>The menu drawer ends in a row of power buttons that is always in view, with Suspend, Restart and Power Off. Search and your collections are on the drawer's first level</li>
          <li>Each fullscreen design has its own look for the menu drawer and Quick Access</li>
          <li>Genres are now called categories everywhere. Fullscreen Home shows them, and genres from every launcher and from Wikidata map onto one set of categories</li>
          <li>A Button Hints switch, in Quick Access and Preferences, hides the hint bar</li>
          <li>Change Buttons moved to Quick Access → Controller</li>
          <li>The starting screen shows the game's logo</li>
          <li>The desktop header bar has a Fullscreen Mode button, and the search field is a pill that widens with the window</li>
          <li>Holding a direction moves focus at the repeat rate and stops where you let go, instead of falling behind</li>
          <li>The library page fits a 360 px window, and the options sheet fits a 720 px screen</li>
          <li>A new console starts on a Get Started checklist in fullscreen mode: connect a controller, join a network, choose a design, add a store and sign in to it, each opening the screen that does it</li>
          <li>Add a Store says when there is no network, and leads to the Network section; an install that fails because Flathub cannot be reached says so</li>
          <li>Once Add a Store installed Steam, Heroic or Lutris, fullscreen mode opens it for its first sign-in, and the library picks up its games without a refresh</li>
          <li>Home's Big Picture tile shows wherever Steam is installed, even before Steam's first start</li>
          <li>Home's animated background pauses behind Quick Access, the menu and the options sheet, and holds still for the session on a machine that cannot keep up with it</li>
          <li>A new console starts on the Get Started checklist with no summary over it; Your Library Is Ready waits for its first games</li>
          <li>A new Apps section in fullscreen mode lists the installed applications that are not games, game launchers included, and opens each with one press. The desktop window can show it too, from Preferences</li>
          <li>Guide + Y leaves Steam Big Picture for the launcher while Steam keeps running, and a system can do the same from Steam's Switch to Desktop. A game Steam started keeps playing behind a Playing Now card</li>
          <li>Steam's first start shows a Setting Up Steam screen with its download progress, Cancel and Try Again, instead of a long wait with nothing on screen</li>
          <li>External importers (experimental): install a helper from Preferences → Sources, see where it runs and which folders it reads, and turn it on to import its games. Bottles is now read by such a helper that comes with Pindu, in a sandbox of its own without network</li>
          <li>An older launcher that meets a library saved by a newer one says so, changes nothing, and offers to start from the copy kept before the upgrade</li>
          <li>Backups keep pinned games, the launch settings of launchers' games and how each game added by hand runs; a Windows game added by hand comes back from an older backup as a Windows game</li>
          <li>The focus ring stays visible in fullscreen mode, toggling a source in Sources keeps the focus on it, and Up past an alert's first button keeps the focus on that button</li>
          <li>The Desktop source shows as found in the application folders instead of "Not found on this computer"</li>
          <li>Fixed a crash in sessions without an accessibility bus</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-11-21">
      <description>
        <p>New fullscreen designs, copies of one game shown as one, save snapshots, Library Health, richer game details, two new sources and much more of the launcher in fullscreen mode.</p>
        <ul>
          <li>Fullscreen mode has three new designs: Lobby, now the default, with labelled section tiles over the animated background; Marquee, which opens Home on your recent games; and Shelves, every section as a row of its games. Ribbon and Panorama are retired, and if you used either, fullscreen mode opens in Lobby</li>
          <li>Adwaita, the look with no design, now follows GNOME Software's Explore page: your recent games in a carousel with Play and Details, a row of sections, then a row of covers for each; Quick Access is a floating card and the menu drawer a plain sidebar</li>
          <li>Steam, Lutris, Bottles, Faugus, Legendary and itch show their own icons in the sidebar, on covers and on fullscreen Home's tiles</li>
          <li>In Lobby, Quick Access lets you choose Home's background under Design: the new Red Ribbons or Blue Station</li>
          <li>Rename a game, or set its developer, genres, release year and description, in its Edit dialog; your changes survive every sync</li>
          <li>Steam games show their release year, genres, controller support and Steam Deck rating, and Lutris and Heroic Amazon games their release year</li>
          <li>Get Metadata From Wikidata, off by default, fills in Steam games' developers and genres on request, and the game page says which values came from Wikidata</li>
          <li>Filter the library by genre or to games never played, and save a filter as a collection whose games follow it</li>
          <li>A list view beside the library grid, and a selection mode that favourites, hides or adds many games to a collection at once, with Undo</li>
          <li>Copies of a game from several sources show as one game: Duplicates suggests copies to group, you can merge and split games by hand, and Copy Order in Preferences decides which copy Play starts</li>
          <li>A Windows game's saves are kept as a snapshot when it exits, can be restored from Save Snapshots, and can also be copied to a folder you choose; any game can have its save folders added by hand</li>
          <li>Library Health, in the main menu and in Quick Access, shows what needs attention with a button for the next step, and the first sync ends with a summary of what it found</li>
          <li>Preferences shows when each source last synced and the problems it ran into</li>
          <li>Games installed with the itch app or with the standalone Legendary command-line tool join the library</li>
          <li>When a launch fails, the game page says why and offers the next step, and Start Safely runs a game once without MangoHud, GameMode or its wrappers</li>
          <li>Steam games link to ProtonDB and PCGamingWiki</li>
          <li>About's Debugging Information holds a report for bug reports, which can include a game's newest log; in fullscreen mode Quick Access shows it to photograph and saves a copy</li>
          <li>Fullscreen mode can add a game, turn sources on and off, take the SteamGridDB key, download and remove Proton builds, choose a game's Proton build, and rename, reorder and delete collections, all with a controller</li>
          <li>The fullscreen game page shows a game's details and description</li>
          <li>Fullscreen mode offers four text sizes, and Hold to Confirm makes Power Off, Restart, Forget and Stop wait for a held button</li>
          <li>Quick Access sets the controller's repeat delay, repeat rate and stick dead zone</li>
          <li>Under high contrast, fullscreen Home's background is still and plain, and text over game art sits on darker shading</li>
          <li>Screen readers hear how many games match a search or filter, Play buttons and check boxes are named after their game, and the game title and Jump Back In are headings</li>
          <li>Tab leaves the library grid in one step, and the arrow keys move between games</li>
          <li>Backups carry game groups, saved filters and the details you or a provider set, and the launcher remembers when you last backed up</li>
          <li>The launcher keeps a copy of your library before it updates the library's format</li>
          <li>Fixed a rare "database is locked" error when the library opens</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.5.1" date="2026-11-19">
      <description>
        <p>Change a game's artwork from SteamGridDB or your own files, and a tidier library.</p>
        <ul>
          <li>Change Artwork, in a game's menu and in fullscreen mode's game options, finds covers, banners, logos, icons and square art on SteamGridDB, page by page, or uses an image file; a picked image shows at once, and Use Original brings the launcher's back</li>
          <li>When SteamGridDB finds the wrong game for a title, Different Game… lets you choose the right one, which is remembered</li>
          <li>Fullscreen mode switches between kinds of art with the shoulder buttons and loads more images as you reach the end</li>
          <li>Jump Back In cards are evenly rounded, their art fills them without blurred bands, and Play shows on hover and keyboard focus</li>
          <li>Fullscreen mode's library spaces covers evenly in rows and columns, so the focused cover is never hidden behind its neighbours</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-18">
      <description>
        <p>Fullscreen mode in gamescope sessions, where the launcher takes Steam's place.</p>
        <ul>
          <li>Play shows a starting screen with the game's art until the game is in front, and offers Cancel after five seconds, so a launch that hangs never leaves you stuck</li>
          <li>In a gamescope session Steam's own launch window stays hidden; Steam shows only when it needs an answer, such as a sign-in or a cloud conflict</li>
          <li>The launcher notices within about two seconds that a game handed to Steam, Heroic or Lutris has ended</li>
          <li>Home opens Steam Big Picture where Steam is installed; the launcher leaves the screen and the controller to Steam until you leave Big Picture</li>
          <li>The menu's Power lists Suspend, Restart, Power Off and Exit, also in the Flatpak with access outside the sandbox; Exit is left out when the launcher is the session itself</li>
          <li>The menu's Controls lets you choose which button does what, and Reset to Defaults brings the usual buttons back</li>
          <li>In a gamescope session started with --steam, the games the launcher starts come to the front, the launcher comes back when they end, and Return in Playing Now goes back to the game</li>
          <li>Guide opens the menu over a running game, as in Steam: Return, Stop, Home and Library, and the game's windows to switch between when it has more than one</li>
          <li>Guide + A, the ⋯ button or a right stick click opens Quick Access, over a running game too, including Network and Bluetooth; Guide on its own acts when you let go of it</li>
          <li>Games handed to Steam, Heroic or Lutris come to the front too and show as playing, with Return instead of Play and a Stop that closes their windows, and Steam's own window shows while it needs an answer</li>
          <li>Steam starts without its library window in a gamescope session, when the launcher may run commands on the host</li>
          <li>"Opening Steam…" no longer stays on screen when the store launcher never answers</li>
          <li>The Performance Overlay switch drives MangoApp in a gamescope session</li>
          <li>The RPM and DEB packages add a "Pindu launcher" session to gamescope-session-plus login screens, with Switch to Desktop in the Power menu</li>
          <li>Games started outside the Flatpak open on the launcher's own display</li>
          <li>Fullscreen mode can install Steam, Heroic or Lutris from Add a Store</li>
          <li>Wi-Fi passphrases and Bluetooth PINs are typed with the on-screen keyboard</li>
          <li>Once the launcher starts a game, the controller is the game's: only Guide and Guide + A reach the launcher until Guide, switching back to it or the game ending, so buttons no longer act in the game and the launcher at once</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-11-17">
      <description>
        <p>A fix for fullscreen mode in virtual machines.</p>
        <ul>
          <li>Fullscreen mode no longer crashes in a virtual machine with 3D acceleration and Venus (virtio-gpu)</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-11-16">
      <description>
        <p>Release files for ARM (aarch64), a fix for a crash on Steam libraries, and more in the fullscreen Quick Access panel.</p>
        <ul>
          <li>Flatpak, RPM and DEB release files are now built for aarch64 (ARM) as well as x86_64</li>
          <li>Fixed a crash when importing a Steam library with deeply nested data</li>
          <li>Windows games use a Proton build made for your machine's architecture</li>
          <li>Turning on MangoHud now explains when it cannot work inside the sandbox</li>
          <li>Quick Access in fullscreen mode gains Network, Bluetooth, System Update, Sound Output and Power sections</li>
          <li>The on-screen keyboard has capitals and symbols, and a dialog for entering passphrases</li>
          <li>The RPM and DEB packages now depend on GStreamer's good plug-ins</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-11-07">
      <description>
        <p>Native packages, your own fullscreen style in Preferences, and the start of translations.</p>
        <ul>
          <li>Install Pindu launcher as an RPM on Fedora 45 or a DEB on Debian testing and Ubuntu 26.10, next to the Flatpak</li>
          <li>Turn your own fullscreen stylesheet on, import it, open its folder or reset it in Preferences, which also lists its problems</li>
          <li>Without umu-launcher, Windows games now say what is missing and how to install it</li>
          <li>The focused cover in the first row of the fullscreen library is no longer cut off</li>
          <li>A first, partial Dutch translation; help translate on Weblate</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-07">
      <description>
        <p>Windows games, and a fullscreen mode for playing from the couch with a controller.</p>
        <ul>
          <li>Add a Windows game from its .exe or installer and play it with Proton, with launch settings and logs for each game</li>
          <li>Download GE-Proton and Proton-CachyOS builds from Preferences</li>
          <li>Run native games in the Steam Linux Runtime, and turn on MangoHud or GameMode for a game</li>
          <li>A fullscreen mode with Home, Library and game pages, an on-screen keyboard for search and a Quick Access panel</li>
          <li>Fullscreen designs, Ribbon and Panorama, with variants, and your own stylesheet</li>
          <li>Reduce Motion, four text sizes and a volume for navigation sounds in fullscreen mode</li>
          <li>Control the desktop window and its menus with a controller</li>
          <li>SteamGridDB art arrives as soon as you save your key</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-04">
      <description>
        <p>The first release.</p>
        <ul>
          <li>One library for Steam, Heroic, Lutris, Bottles, Faugus, installed apps and games you add yourself</li>
          <li>Collections, favourites, Jump Back In and play history</li>
          <li>Artwork from your launchers, your own files or SteamGridDB</li>
          <li>Search from GNOME Shell</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
