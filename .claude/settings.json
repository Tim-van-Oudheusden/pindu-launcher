{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo doc *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(RUSTDOCFLAGS=\"-D warnings\" cargo doc *)",
      "Bash(meson *)",
      "Bash(ninja *)",
      "Bash(flatpak-builder *)",
      "Bash(flatpak-builder-lint *)",
      "Bash(flatpak run *)",
      "Bash(blueprint-compiler *)",
      "Bash(po/check-pot.sh *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Edit(./Cargo.toml)",
      "Edit(./crates/*/Cargo.toml)",
      "Edit(./Cargo.lock)",
      "Edit(./build-aux/flatpak/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./AI_DISCLOSURE.md)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo install *)",
      "Bash(flatpak install *)",
      "Bash(flatpak uninstall *)",
      "Bash(flatpak override *)",
      "Bash(git tag *)",
      "Bash(git push * --tags)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo *)"
    ]
  }
}
